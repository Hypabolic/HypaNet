.venv/
__pycache__/
*.pyc
.pytest_cache/
# generated data (manifests and hashes are committed, data files are not)
datasets/**/*.jsonl
datasets/**/*.jsonl.gz
datasets/**/*.npz
authoring_packet/

.pytest_tmp/
datasets/**/*.encoded.pt
datasets/**/*.encoded.pt.tmp

# Claude Code workflow worktrees
.claude/worktrees/

# v0.4 WSP: large binaries stay local (the edit rebuilds from build_edit.py + constants; hashes are in BUILD_RECORD.json and author_output_manifest.json)
experiments/v0_4/logs/*/journal/
weight_program/v0_4/*/edit.safetensors
weight_program/v0_4/*/author_output/**/*.npz
experiments/v0_4/columns/*.partial.npz
experiments/v0_4/columns/*.shards/*.npz
experiments/v0_4/columns/*.shards/*.partial.npz
experiments/v0_4/benchmarks/*/runs/

# v0.5 OOD diagnosis: window rows regenerate from analyse.py
experiments/v0_5/ood_analysis/rows*.jsonl.gz

# Clouds scoring: linear renders regenerate with renderer/render.py --set all (PNGs and JSON are committed)
clouds/runs/r1/score/**/*.npy

# Clouds videos: per-frame scenes, linear frames and PNGs regenerate with clouds/video/make_video.py
clouds/video/out/*/scene/
clouds/video/out/*/linear/
clouds/video/out/*/frames/
clouds/video/out_full.log
clouds/video/out/*/*.gif
