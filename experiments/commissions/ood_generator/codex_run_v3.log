"""Independent OOD histories composed from causal repository workflows.

Phase lengths, operation order, side work and episode counts use only the
caller's RNG. Scripts choose operations, never effects or window labels.
"""

from collections.abc import Callable
import random

from ..oracle_config import OracleConfig
from ..schema import CanonicalEvent, OracleRecord
from .engine import Engine


def _plan(e: Engine, action: str) -> None:
    e.perform("plan", args={"action_type": action})


def _repair(e: Engine, count: int) -> None:
    """Work on remaining faults; vary inspection and validation placement."""
    broken = [p for p in e.repo.paths if "enabled=0" in e.repo.files[p].splitlines()]
    for path in e.rng.sample(broken, min(count, len(broken))):
        style = e.rng.randrange(4)
        if style in (0, 1):
            e.read(path)
        if style == 1:
            _plan(e, f"isolate:{path}")
        e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
        e.test()
        if style == 2:
            e.read(path)
        elif style == 3:
            _plan(e, f"record:{path}")


def _investigate(e: Engine, count: int) -> None:
    for path in e.rng.sample(e.repo.paths, count):
        e.read(path)
        side = e.rng.randrange(3)
        if side == 1:
            _plan(e, f"trace:{path}")
        elif side == 2:
            e.test()


def _recover(e: Engine, kind: str, episodes: int) -> None:
    for i in range(episodes):
        resource = f"quorum-{len(e.events)}-{i}.cedar.invalid"
        failures = e.rng.randint(2, 3) if kind == "retry" else e.rng.randint(2, 5)
        e.service(resource, kind, failures)
        for attempt in range(failures + 1):
            if kind == "retry":
                e.perform("http_call", {"method": "POST", "host": resource,
                                      "path_template": "/lease/{key}"},
                          {"body": '{"lease":"replica"}'})
            else:
                e.perform("poll_status", resource, {"backoff": 2**attempt})
        # Side work follows resolution, preserving each unfinished retry.
        if e.rng.random() < .5:
            _plan(e, "record-quorum")


def _stall(e: Engine, count: int) -> None:
    for _ in range(count):
        e.test()


def _notes(e: Engine, count: int) -> None:
    path = e.rng.choice(e.repo.paths)
    e.read(path)
    for i in range(count):
        e.write(path, e.repo.files[path] + f"# investigation {i}\n")
        if e.rng.random() < .5:
            e.test()
        else:
            e.read(path)


def _oscillate(e: Engine, path: str, cycles: int) -> None:
    left = e.repo.files[path]
    if path == "config/merge.conf":
        right = "owner=upstream\n"
    elif path == "config/replica.lock":
        right = "package=cedar\nversion=2\n"
    else:
        right = left.replace("mode=left", "mode=right")
    for i in range(cycles):
        e.write(path, right if i % 2 == 0 else left)
        side = e.rng.randrange(4)
        if side == 1:
            e.read(path)
        elif side == 2:
            _plan(e, "reconcile-conventions")
        elif side == 3:
            e.test()


def _handoff(e: Engine) -> None:
    for i in range(e.rng.randint(0, 5)):
        _plan(e, f"handoff:{len(e.events)}:{i}")


def shard_migration(rng, session_id, cfg):
    """PRODUCTIVE, RECOVERY: migration hits lease interruptions, then resumes."""
    e = Engine(rng, session_id, cfg)
    e.test()
    # Paired edit probe: annotation/serializer use the same schedule with
    # different causal file contents.
    for path in rng.sample(e.repo.paths, 8):
        e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
        e.test()
    _recover(e, rng.choice(["retry", "poll"]), rng.randint(1, 3))
    if rng.random() < .5:
        _notes(e, rng.randint(4, 7))
    _repair(e, rng.randint(3, 4))
    _handoff(e)
    return e.finish("shard_migration")


def fixture_archaeology(rng, session_id, cfg):
    """PRODUCTIVE, STALLED: discovery, a documentation dead end, then repair."""
    e = Engine(rng, session_id, cfg)
    _investigate(e, rng.randint(5, 8))
    if rng.random() < .5:
        _repair(e, 1)
    _notes(e, rng.randint(7, 10))
    _repair(e, rng.randint(3, 5))
    _handoff(e)
    return e.finish("fixture_archaeology")


def lease_reconnect(rng, session_id, cfg):
    """RECOVERY, PRODUCTIVE: repair surrounds variable multi-host lease outages."""
    e = Engine(rng, session_id, cfg)
    _repair(e, 3)
    _recover(e, "retry", rng.randint(2, 4))
    if rng.random() < .5:
        _investigate(e, rng.randint(1, 3))
        _recover(e, "poll", 1)
    _repair(e, rng.randint(3, 5))
    _handoff(e)
    return e.finish("lease_reconnect")


def index_watermark(rng, session_id, cfg):
    """RECOVERY, PRODUCTIVE: bounded watermark waits interleaved with repairs."""
    e = Engine(rng, session_id, cfg)
    _repair(e, 3)
    for _ in range(rng.randint(2, 4)):
        _recover(e, "poll", 1)
        if rng.random() < .5:
            _repair(e, 1)
    _repair(e, rng.randint(3, 4))
    _handoff(e)
    return e.finish("index_watermark")


def pinned_validation(rng, session_id, cfg):
    """PRODUCTIVE, RECOVERY, STALLED: repair, pinned failing retries, diagnosis."""
    e = Engine(rng, session_id, cfg)
    _repair(e, 3)
    _handoff(e)
    _stall(e, rng.randint(14, 24))
    if rng.random() < .5:
        _investigate(e, rng.randint(1, 3))
    _repair(e, rng.randint(3, 5))
    _handoff(e)
    return e.finish("pinned_validation")


def annotation_spiral(rng, session_id, cfg):
    """STALLED, PRODUCTIVE: cosmetic fixes give way to predicate repairs."""
    e = Engine(rng, session_id, cfg)
    path = rng.choice(e.repo.paths)
    e.test()
    for i in range(8):
        e.write(path, e.repo.files[path] + f"# explanation {i}\n")
        e.test()
    if rng.random() < .5:
        _notes(e, rng.randint(2, 6))
    _repair(e, rng.randint(3, 5))
    if rng.random() < .5:
        _recover(e, "retry", rng.randint(1, 3))
        _repair(e, 3)
    _handoff(e)
    return e.finish("annotation_spiral")


def serializer_duel(rng, session_id, cfg):
    """OSCILLATING, PRODUCTIVE: opposing serializers eventually yield to repair."""
    e = Engine(rng, session_id, cfg)
    path = rng.choice(e.repo.paths)
    left = e.repo.files[path]
    right = left.replace("mode=left", "mode=right")
    e.test()
    for i in range(8):
        e.write(path, right if i % 2 == 0 else left)
        e.test()
    _oscillate(e, path, rng.randint(2, 7))
    if rng.random() < .5:
        _recover(e, rng.choice(["retry", "poll"]), rng.randint(1, 2))
    _repair(e, rng.randint(3, 6))
    _handoff(e)
    return e.finish("serializer_duel")


def _negotiation(e: Engine, path: str) -> None:
    _repair(e, 3)
    _oscillate(e, path, e.rng.randint(10, 16))
    if e.rng.random() < .5:
        _recover(e, e.rng.choice(["retry", "poll"]), 1)
    _repair(e, e.rng.randint(3, 5))
    _handoff(e)


def merge_ping_pong(rng, session_id, cfg):
    """PRODUCTIVE, OSCILLATING: ownership dispute, then actual fault repair.

    Absent from §7.1: concrete upstream/local merge ownership negotiation.
    """
    e = Engine(rng, session_id, cfg)
    _negotiation(e, "config/merge.conf")
    return e.finish("merge_ping_pong")


def lockfile_churn(rng, session_id, cfg):
    """PRODUCTIVE, OSCILLATING: competing dependency pins, then contract repair.

    Absent from §7.1: installer/resolver dependency negotiation.
    """
    e = Engine(rng, session_id, cfg)
    _negotiation(e, "config/replica.lock")
    return e.finish("lockfile_churn")


def telemetry_gaps(rng, session_id, cfg):
    """PRODUCTIVE plus RECOVERY/STALLED/OSCILLATING: workflows with telemetry loss.

    Two workflows sampled from validation, serializer/merge/lock, lease and
    watermark mechanics supply clean windows before the observation-loss burst.
    """
    e = Engine(rng, session_id, cfg)
    _repair(e, 3)
    workflows = ["validation", "serializer", "merge", "lock", "lease", "watermark"]
    for workflow in rng.sample(workflows, 2):
        if workflow == "validation":
            _stall(e, rng.randint(14, 18))
        elif workflow in ("lease", "watermark"):
            _recover(e, "retry" if workflow == "lease" else "poll", 2)
        else:
            path = {"serializer": e.repo.paths[-1], "merge": "config/merge.conf",
                    "lock": "config/replica.lock"}[workflow]
            _oscillate(e, path, rng.randint(8, 10))
    e.perform("plan", args={"action_type": "audit-transport"}, dropped="tokens")
    e.perform("read_file", e.repo.paths[0], dropped="workspace")
    e.test(dropped="failure")
    # Missing suite/counts hide the next result's baseline. The engine marks
    # that dependency dropped until a complete result restores the baseline.
    for field in ("validation_suite", "validation_passed", "validation_total"):
        e.test(dropped=field)
    e.test()
    e.test()
    _repair(e, 3)
    _handoff(e)
    return e.finish("telemetry_gaps")


FAMILIES: dict[str, Callable[[random.Random, str, OracleConfig],
                           tuple[list[CanonicalEvent], OracleRecord]]] = {
    f.__name__: f for f in (
        shard_migration, fixture_archaeology, lease_reconnect, index_watermark,
        pinned_validation, annotation_spiral, serializer_duel, merge_ping_pong,
        lockfile_churn, telemetry_gaps,
    )
}
"""Independent, small repository interpreter and causal operation engine.

Files are simulated text, never files in the caller's checkout. The interpreted
contract is deliberately language independent: enabled=1 repairs a contract;
mode selects a competing deployment convention without repairing a contract.
"""

from __future__ import annotations

import random
from datetime import datetime, timedelta, timezone

from ..fingerprint import (
    FAMILY_CATEGORY, failure_fingerprint, intent_fingerprint, workspace_digest,
)
from ..oracle_config import OracleConfig
from ..schema import CanonicalEvent, LatentEffect as E, OracleRecord, Outcome, Provenance
from ..synth.labeller import label_session
from ..synth.latent import LatentStep, latent_trace


class Repository:
    """Textual contracts, independent facts, behaviour, and test interpretation."""

    def __init__(self, rng: random.Random):
        language, suffix, suite = rng.choice([
            ("Elixir", "exs", "exunit:replication"),
            ("Zig", "zig", "zig:allocator"),
            ("Lua", "lua", "busted:stream"),
            ("Clojure", "clj", "kaocha:ledger"),
        ])
        self.suite = suite
        self.error_class = rng.choice(["ReplicaDivergence", "AllocatorInvariant", "StreamOrderViolation"])
        self.paths = [f"lib/shards/contract_{i}.{suffix}" for i in range(rng.randint(12, 18))]
        self.files = {p: f"# {language} contract {i}\nenabled=0\nmode=left\n"
                      for i, p in enumerate(self.paths)}
        self.files["config/replica.lock"] = "package=cedar\nversion=1\n"
        self.files["config/merge.conf"] = "owner=local\n"

    def behaviour(self) -> tuple:
        return tuple((p, tuple(line for line in text.splitlines()
                              if line and not line.startswith("#")))
                     for p, text in sorted(self.files.items()))

    def passing(self) -> int:
        return sum("enabled=1" in self.files[p].splitlines() for p in self.paths)

    def progress(self) -> float:
        return self.passing() / len(self.paths)

    def digest(self) -> str:
        return workspace_digest(self.files)


class Engine:
    """Apply operations, derive effects from state, then emit observations.

The only scenario input is the operation to attempt. Effects and labels are
never supplied by scenario scripts. No encoder is imported here.
"""

    def __init__(self, rng: random.Random, session_id: str, cfg: OracleConfig):
        self.rng, self.session_id, self.cfg = rng, session_id, cfg
        # The API receives an RNG rather than its seed. Record a reproducible
        # stream nonce, not a claim to know the caller's original seed.
        self.seed = rng.getrandbits(63)
        self.repo = Repository(rng)
        self.p0 = self.repo.progress()
        self.knowledge: set[str] = set()
        self.inspected: set[tuple] = set()
        self.validated: set[tuple] = set()
        self.controls: set[tuple] = set()
        self.services: dict[str, tuple[str, int]] = {}
        self.service_calls: dict[str, int] = {}
        self.events: list[CanonicalEvent] = []
        self.steps: list[LatentStep] = []
        self.states = [self.repo.digest()]
        self.last_failure: tuple | None = None
        self.episode_key: tuple | None = None
        self.episode_kind: str | None = None
        self.attempts = 0
        self.unrelated = 0
        self.clock = datetime(2026, 3, 14, tzinfo=timezone.utc)

    def service(self, name: str, kind: str, failures: int) -> None:
        self.services[name] = (kind, failures)
        self.service_calls[name] = 0

    def close_episode(self) -> None:
        self.episode_key = self.episode_kind = None
        self.attempts = self.unrelated = 0

    def perform(self, family: str, target=None, args=None, *, content=None,
                dropped: str | None = None) -> None:
        args = dict(args or {})
        before, behaviour, previous_p = self.repo.digest(), self.repo.behaviour(), self.repo.progress()
        facts: set[str] = set()
        redundant = False
        outcome, error_class, produced = Outcome.SUCCESS, None, False
        error_location = None
        passed = total = suite = None
        kind = None
        # Relevant state for retry equality is behavioural, so cosmetic edits
        # do not make a deterministic failing validation a fresh attempt.
        key = (family, repr(target), repr(sorted(args.items())), behaviour)
        if family == "read_file":
            text = self.repo.files[target]
            read_key = (target, text)
            redundant = read_key in self.inspected
            self.inspected.add(read_key)
            if target in self.repo.paths:
                facts = {f"{target}:predicate", f"{target}:fixture"} - self.knowledge
                redundant = not facts
        elif family == "write_file":
            args = {"content": content}
            self.repo.files[target] = content
            redundant = self.repo.behaviour() == behaviour
        elif family == "run_tests":
            produced, suite = True, target
            passed, total = self.repo.passing(), len(self.repo.paths)
            validation_key = (target, tuple(sorted(args.get("tests", []))), behaviour)
            key = (family, validation_key)
            redundant = validation_key in self.validated
            self.validated.add(validation_key)
            if passed < total:
                outcome, error_class, kind = Outcome.ERROR, self.repo.error_class, "retry"
                error_location = next(p for p in self.repo.paths if "enabled=1" not in self.repo.files[p].splitlines())
        elif family in ("http_call", "poll_status"):
            resource = target if family == "poll_status" else target["host"]
            error_location = resource
            kind, failures = self.services[resource]
            self.service_calls[resource] += 1
            # Caller metadata such as backoff never distinguishes an attempt.
            key = ((family, resource) if family == "poll_status" else
                   (family, tuple(sorted(target.items())), args.get("body")))
            if self.service_calls[resource] <= failures:
                outcome = Outcome.NEUTRAL if kind == "poll" else Outcome.ERROR
                error_class = "LeaseNotReady" if kind == "poll" else "PeerReset"
            else:
                facts = {f"service:{resource}:lease"} - self.knowledge
        elif family == "plan":
            control_key = (family, args["action_type"])
            redundant = control_key in self.controls
            self.controls.add(control_key)
        else:
            raise ValueError(f"unsupported simulated operation: {family}")

        after = self.repo.digest()
        mutation = before != after
        p = self.repo.progress()
        new_facts = len(facts)
        self.knowledge.update(facts)
        undo = mutation and after in self.states and len(self.states) > 1
        recent_states = {s.ws_before for s in self.steps[-7:]} | {s.ws_after for s in self.steps[-7:]}
        recent_states.add(before)
        reversion = undo and after in recent_states

        failed = kind is not None and outcome in (Outcome.ERROR, Outcome.NEUTRAL)
        exact_retry = key == self.last_failure
        resolved = False
        policy_effect = None
        if exact_retry:
            if self.episode_key != key:
                self.close_episode()
                self.episode_key, self.episode_kind = key, kind
            self.attempts += 1
            self.unrelated = 0
            if not failed:
                resolved = True
                self.close_episode()
            else:
                limit = self.cfg.p_max if kind == "poll" else self.cfg.r_max
                policy_effect = (E.IN_POLICY_POLL if kind == "poll" else E.IN_POLICY_RETRY) if self.attempts <= limit else E.REDUNDANT
        else:
            if self.episode_kind:
                self.unrelated += 1
                if self.repo.behaviour() != behaviour or self.unrelated >= 2:
                    self.close_episode()
        self.last_failure = key if failed else None

        if resolved:
            effect = E.RESOLVES_EPISODE
        elif p > previous_p:
            effect = E.PROGRESS
        elif new_facts:
            effect = E.NEW_FACT
        elif reversion:
            effect = E.REVERSION
        elif policy_effect is not None:
            effect = policy_effect
        elif redundant:
            effect = E.REDUNDANT
        else:
            effect = E.NONE

        # Missing validation telemetry can also hide the next result's
        # baseline. Track that dependency at the observation boundary, without
        # consulting the gate, encoder, or oracle. A complete result restores
        # the baseline for the following result.
        baseline_missing = False
        if produced:
            for previous in reversed(self.events):
                if previous.validation_produced and previous.validation_suite_id in (None, suite):
                    baseline_missing = (previous.validation_suite_id is None or
                                        previous.validation_passed is None or
                                        previous.validation_total is None)
                    break
        i = len(self.events)
        self.steps.append(LatentStep(
            i, effect, p, new_facts, before, after, mutation, undo,
            self.episode_kind, self.attempts, resolved, dropped is not None or baseline_missing,
        ))
        # A zero-inflated, heavy-tailed cost law, independent of labels.
        cost = 0 if self.rng.random() < .13 else min(400000, int(self.rng.lognormvariate(7.5, 1.65)))
        fraction = self.rng.uniform(.35, .96)
        input_tokens = int(cost * fraction)
        self.clock += timedelta(milliseconds=self.rng.randint(30, 1700))
        self.events.append(CanonicalEvent(
            session_id=self.session_id, agent_id="worker", task_id="contract-maintenance",
            event_id=f"{self.session_id}:{i}", sequence_index=i,
            timestamp=self.clock.isoformat(), operation_family=family,
            operation_category=FAMILY_CATEGORY[family], outcome=outcome,
            intent_fingerprint=intent_fingerprint(family, target, args),
            failure_fingerprint=(None if dropped == "failure" else failure_fingerprint(family, error_class, error_location)) if outcome is Outcome.ERROR else None,
            workspace_state_before=None if dropped == "workspace" else before,
            workspace_state_after=None if dropped == "workspace" else after,
            validation_produced=produced,
            validation_suite_id=None if dropped == "validation_suite" else suite,
            validation_passed=None if dropped == "validation_passed" else passed,
            validation_total=None if dropped == "validation_total" else total,
            input_tokens=None if dropped == "tokens" else input_tokens,
            output_tokens=cost-input_tokens,
            provenance=Provenance(source="simulator:ood-0.1"),
        ))
        self.states.append(after)

    def read(self, path: str) -> None:
        self.perform("read_file", path)

    def write(self, path: str, text: str) -> None:
        self.perform("write_file", path, content=text)

    def test(self, *, dropped=None) -> None:
        self.perform("run_tests", self.repo.suite, {"tests": ["replica-contract"]}, dropped=dropped)

    def finish(self, name: str) -> tuple[list[CanonicalEvent], OracleRecord]:
        return self.events, OracleRecord(
            session_id=self.session_id, generator_version="ood-0.1", seed=self.seed,
            scenario_family=f"ood:{name}", event_effects=tuple(s.effect for s in self.steps),
            window_labels=label_session(self.steps, self.p0, self.cfg),
            dropped_observations=tuple(s.sequence_index for s in self.steps if s.dropped),
            latent_trace=latent_trace(self.steps, self.p0),
        )
"""Causal paired continuations required by spec §7.2.

Alternative histories deliberately share session/event IDs in their identical
prefix. Keep each pair in one dataset partition and never concatenate its two
alternative histories into a single event stream.
"""

from copy import deepcopy
import random

from ..oracle_config import OracleConfig
from ..schema import CanonicalEvent, OracleRecord
from .engine import Engine

Session = tuple[list[CanonicalEvent], OracleRecord]


def _branch(e: Engine, rng: random.Random) -> Engine:
    branch = deepcopy(e)
    # All new random draws still use the caller's RNG. Only world/history state
    # is forked; no independent or global random stream is introduced.
    branch.rng = rng
    return branch


def counterfactual_pairs(
    rng: random.Random, session_id: str, cfg: OracleConfig,
) -> dict[str, tuple[Session, Session]]:
    """Return successful/doomed retry, useful/inert edit, useful/reversal pairs.

    Each pair shares nine byte-identical prefix events. The single intervention
    is service persistence or the edit strategy. The agent's subsequent policy
    reacts to success by resuming repair, or to failure by continuing retries.
    """
    result = {}
    e = Engine(rng, f"{session_id}:lease", cfg)
    for i in range(8):
        e.perform("plan", args={"action_type": f"prepare:{i}"})
    host = "relay.cedar.invalid"
    target = {"method": "GET", "host": host, "path_template": "/lease"}
    e.service(host, "retry", 2)
    e.perform("http_call", target)
    persistent = _branch(e, rng)
    # The only world intervention: a persistent rather than transient outage.
    persistent.services[host] = ("retry", 1000)
    for _ in range(2):
        e.perform("http_call", target)
    for path in e.repo.paths[:5]:
        e.read(path)
        e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
        e.test()
    for _ in range(17):
        persistent.perform("http_call", target)
    result["service_persistence"] = (e.finish("transient_lease"), persistent.finish("persistent_lease"))

    for strategy in ("annotation", "reversal"):
        e = Engine(rng, f"{session_id}:{strategy}", cfg)
        for i in range(8):
            e.perform("plan", args={"action_type": f"prepare:{i}"})
        e.test()
        alternative = _branch(e, rng)
        path = alternative.repo.paths[0]
        original = alternative.repo.files[path]
        for i, repair_path in enumerate(e.repo.paths[:10]):
            e.write(repair_path, e.repo.files[repair_path].replace("enabled=0", "enabled=1"))
            e.test()
            text = (original + f"# repair note {i}\n" if strategy == "annotation" else
                    original.replace("mode=left", "mode=right") if i % 2 == 0 else original)
            alternative.write(path, text)
            alternative.test()
        result[f"edit_{strategy}"] = (e.finish("effective_edit"), alternative.finish(f"{strategy}_edit"))
    return result

