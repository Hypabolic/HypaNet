    },
    {
      "definition": "1 iff operation_category == MUTATE",
      "feature_index": 1,
      "name": "cat_MUTATE"
    },
    {
      "definition": "1 iff operation_category == VALIDATE",
      "feature_index": 2,
      "name": "cat_VALIDATE"
    },
    {
      "definition": "1 iff operation_category == EXTERNAL",
      "feature_index": 3,
      "name": "cat_EXTERNAL"
    },
    {
      "definition": "1 iff operation_category == CONTROL",
      "feature_index": 4,
      "name": "cat_CONTROL"
    },
    {
      "definition": "1 iff outcome == SUCCESS",
      "feature_index": 5,
      "name": "out_SUCCESS"
    },
    {
      "definition": "1 iff outcome == ERROR",
      "feature_index": 6,
      "name": "out_ERROR"
    },
    {
      "definition": "1 iff outcome == NEUTRAL",
      "feature_index": 7,
      "name": "out_NEUTRAL"
    },
    {
      "definition": "1 iff intent_fingerprint equals that of an earlier event in this window",
      "feature_index": 8,
      "name": "repeated_intent"
    },
    {
      "definition": "1 iff outcome == ERROR and failure_fingerprint equals that of an earlier ERROR event in this window",
      "feature_index": 9,
      "name": "repeated_failure"
    },
    {
      "definition": "1 iff workspace_state_before != workspace_state_after",
      "feature_index": 10,
      "name": "workspace_changed"
    },
    {
      "definition": "1 iff workspace_changed == 1 and workspace_state_after equals any before- or after-digest of an earlier event in this window (including the first event's before-state)",
      "feature_index": 11,
      "name": "state_revisited"
    },
    {
      "definition": "1 iff this event produced a validation result and an earlier result from the same validation_suite_id exists anywhere earlier in the session",
      "feature_index": 12,
      "name": "validation_comparable"
    },
    {
      "definition": "if validation_comparable: clip(passed/total - prev_passed/prev_total, -1, 1) against the most recent earlier result from that suite; else 0",
      "feature_index": 13,
      "name": "validation_delta"
    },
    {
      "definition": "min(1, log1p(input_tokens + output_tokens) / log1p(100000)); 0 for a verified zero-token step",
      "feature_index": 14,
      "name": "relative_token_cost"
    }
  ],
  "features_per_event": 15,
  "input_dim": 120,
  "layout": "flat_index = position * features_per_event + feature_index; position 0 is the oldest event of the window, position 7 the newest (the window endpoint)",
  "outcome_order": [
    "SUCCESS",
    "ERROR",
    "NEUTRAL"
  ],
  "spec_version": "0.2"
}

