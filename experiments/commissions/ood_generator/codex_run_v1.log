    def to_class(self) -> ClassLabel:
        if not self.is_scored:
            raise ValueError(f"{self.value} has no network class")
        return ClassLabel[self.name]


class LatentEffect(str, Enum):
    """Per-operation latent effect (spec §6.1). Oracle-only."""

    PROGRESS = "PROGRESS"
    NEW_FACT = "NEW_FACT"
    RESOLVES_EPISODE = "RESOLVES_EPISODE"
    IN_POLICY_RETRY = "IN_POLICY_RETRY"
    IN_POLICY_POLL = "IN_POLICY_POLL"
    REVERSION = "REVERSION"
    REDUNDANT = "REDUNDANT"
    NONE = "NONE"


class SchemaError(ValueError):
    """Raised when an event or record violates the canonical contract."""


def _require(cond: bool, msg: str) -> None:
    if not cond:
        raise SchemaError(msg)


def _opt_nonneg_int(name: str, value: Any) -> None:
    if value is None:
        return
    _require(isinstance(value, int) and not isinstance(value, bool), f"{name} must be int or None")
    _require(value >= 0, f"{name} must be >= 0")


def _iso_timestamp(name: str, value: str) -> None:
    """ISO-8601 as accepted by ``datetime.fromisoformat`` (Python 3.12), plus a trailing ``Z`` for UTC.

    Only validated, never normalised: the string is kept as given.
    """
    text = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        datetime.fromisoformat(text)
    except ValueError as exc:
        raise SchemaError(f"{name} must be an ISO-8601 timestamp, got {value!r}") from exc


_HEX64 = re.compile(r"[0-9a-f]{64}")


def _opt_hex(name: str, value: Any) -> None:
    """Canonical digest: exactly 64 lowercase hex chars (``hashlib.sha256().hexdigest()``).

    Digests are compared by plain string equality downstream, so non-canonical
    spellings (uppercase, ``0x`` prefix, ``_`` separators, whitespace) are rejected.
    """
    if value is None:
        return
    _require(
        isinstance(value, str) and _HEX64.fullmatch(value) is not None,
        f"{name} must be a 64-char lowercase sha256 hex digest or None",
    )


@dataclass(frozen=True)
class Provenance:
    """Where an event came from and how well it was instrumented.

    ``history_complete`` is True iff the event stream for this session is known
    to start at the session's first operation (no truncated prefix). The gate
    uses it to decide whether a missing validation baseline is *unobserved*
    rather than genuinely absent (spec §5.2).
    """

    source: str  # e.g. "simulator:0.2.0" or "adapter:otel-genai:1"
    history_complete: bool = True
    instrumentation_flags: tuple[str, ...] = ()
    trace_id: str | None = None
    span_ids: tuple[str, ...] = ()

    def __post_init__(self) -> None:
        _require(isinstance(self.source, str) and self.source != "", "provenance.source required")
        _require(isinstance(self.history_complete, bool), "provenance.history_complete must be bool")
        object.__setattr__(self, "instrumentation_flags", tuple(self.instrumentation_flags))
        object.__setattr__(self, "span_ids", tuple(self.span_ids))

    def to_dict(self) -> dict[str, Any]:
        return {
            "source": self.source,
            "history_complete": self.history_complete,
            "instrumentation_flags": list(self.instrumentation_flags),
            "trace_id": self.trace_id,
            "span_ids": list(self.span_ids),
        }

    @classmethod
    def from_dict(cls, d: Mapping[str, Any]) -> "Provenance":
        allowed = {f.name for f in fields(cls)}
        extra = set(d) - allowed
        _require(not extra, f"unknown provenance fields: {sorted(extra)}")
        return cls(
            source=d["source"],
            history_complete=d.get("history_complete", True),
            instrumentation_flags=tuple(d.get("instrumentation_flags", ())),
            trace_id=d.get("trace_id"),
            span_ids=tuple(d.get("span_ids", ())),
        )


@dataclass(frozen=True)
class CanonicalEvent:
    """One completed logical agent operation (spec §3.1).

    Validation fields: ``validation_produced`` is True iff this operation
    produced a comparable validation result. When True, suite id / passed /
    total are expected (``None`` means unobserved, which the gate rejects).
    When False they must all be ``None``. A validation result implies category
    VALIDATE.
    """

    session_id: str
    agent_id: str
    task_id: str
    event_id: str
    sequence_index: int
    timestamp: str
    operation_family: str
    operation_category: OperationCategory
    outcome: Outcome
    intent_fingerprint: str
    provenance: Provenance
    failure_fingerprint: str | None = None
    workspace_state_before: str | None = None
    workspace_state_after: str | None = None
    validation_produced: bool = False
    validation_suite_id: str | None = None
    validation_passed: int | None = None
    validation_total: int | None = None
    input_tokens: int | None = None
    output_tokens: int | None = None

    def __post_init__(self) -> None:
        for name in ("session_id", "agent_id", "task_id", "event_id", "timestamp", "operation_family"):
            v = getattr(self, name)
            _require(isinstance(v, str) and v != "", f"{name} must be a non-empty str")
        _iso_timestamp("timestamp", self.timestamp)
        _require(
            isinstance(self.sequence_index, int) and not isinstance(self.sequence_index, bool) and self.sequence_index >= 0,
            "sequence_index must be int >= 0",
        )
        # Coerce enums given as strings, reject anything else.
        try:
            object.__setattr__(self, "operation_category", OperationCategory(self.operation_category))
            object.__setattr__(self, "outcome", Outcome(self.outcome))
        except ValueError as exc:
            raise SchemaError(str(exc)) from exc
        _require(isinstance(self.provenance, Provenance), "provenance must be a Provenance")
        _opt_hex("intent_fingerprint", self.intent_fingerprint)
        _require(self.intent_fingerprint is not None, "intent_fingerprint required")
        _opt_hex("failure_fingerprint", self.failure_fingerprint)
        _require(
            self.failure_fingerprint is None or self.outcome is Outcome.ERROR,
            "failure_fingerprint only allowed when outcome == ERROR",
        )
        _opt_hex("workspace_state_before", self.workspace_state_before)
        _opt_hex("workspace_state_after", self.workspace_state_after)
        _opt_nonneg_int("validation_passed", self.validation_passed)
        _opt_nonneg_int("validation_total", self.validation_total)
        _opt_nonneg_int("input_tokens", self.input_tokens)
        _opt_nonneg_int("output_tokens", self.output_tokens)
        _require(isinstance(self.validation_produced, bool), "validation_produced must be bool")
        if self.validation_produced:
            _require(
                self.operation_category is OperationCategory.VALIDATE,
                "validation_produced requires operation_category == VALIDATE",
            )
            if self.validation_total is not None:
                _require(self.validation_total >= 1, "validation_total must be >= 1")
            if self.validation_passed is not None and self.validation_total is not None:
                _require(self.validation_passed <= self.validation_total, "validation_passed > validation_total")
        else:
            _require(
                self.validation_suite_id is None and self.validation_passed is None and self.validation_total is None,
                "validation fields must be None when validation_produced is False",
            )

    # -- serialisation -------------------------------------------------------

    def to_dict(self) -> dict[str, Any]:
        out: dict[str, Any] = {}
        for f in fields(self):
            v = getattr(self, f.name)
            if isinstance(v, Enum):
                v = v.value
            elif isinstance(v, Provenance):
                v = v.to_dict()
            out[f.name] = v
        return out

    @classmethod
    def from_dict(cls, d: Mapping[str, Any]) -> "CanonicalEvent":
        allowed = {f.name for f in fields(cls)}
        extra = set(d) - allowed
        _require(not extra, f"unknown CanonicalEvent fields (possible oracle leakage): {sorted(extra)}")
        kwargs = dict(d)
        kwargs["provenance"] = Provenance.from_dict(d["provenance"])
        return cls(**kwargs)

    def to_json(self) -> str:
        """Canonical JSON: sorted keys, no insignificant whitespace, UTF-8 safe."""
        return json.dumps(self.to_dict(), sort_keys=True, separators=(",", ":"), ensure_ascii=False)

    @classmethod
    def from_json(cls, s: str) -> "CanonicalEvent":
        return cls.from_dict(json.loads(s))

    @property
    def step_tokens(self) -> int | None:
        if self.input_tokens is None or self.output_tokens is None:
            return None
        return self.input_tokens + self.output_tokens


@dataclass(frozen=True)
class OracleRecord:
    """Sealed ground truth for one session (spec §6). Never on the inference path.

    ``event_effects[i]`` is the latent effect of the event with sequence_index i.
    ``window_labels`` maps window endpoint sequence_index -> OracleLabel.
    ``dropped_observations`` lists sequence indices where the generator
    deliberately dropped a required observation (scenario 12, rule 1).
    """

    session_id: str
    generator_version: str
    seed: int
    scenario_family: str
    event_effects: tuple[LatentEffect, ...]
    window_labels: Mapping[int, OracleLabel] = field(default_factory=dict)
    dropped_observations: tuple[int, ...] = ()
    latent_trace: Mapping[str, Any] = field(default_factory=dict)  # free-form diagnostics

    def to_dict(self) -> dict[str, Any]:
        return {
            "session_id": self.session_id,
            "generator_version": self.generator_version,
            "seed": self.seed,
            "scenario_family": self.scenario_family,
            "event_effects": [e.value for e in self.event_effects],
            "window_labels": {str(k): v.value for k, v in sorted(self.window_labels.items())},
            "dropped_observations": list(self.dropped_observations),
            "latent_trace": dict(self.latent_trace),
        }

    @classmethod
    def from_dict(cls, d: Mapping[str, Any]) -> "OracleRecord":
        return cls(
            session_id=d["session_id"],
            generator_version=d["generator_version"],
            seed=int(d["seed"]),
            scenario_family=d["scenario_family"],
            event_effects=tuple(LatentEffect(e) for e in d["event_effects"]),
            window_labels={int(k): OracleLabel(v) for k, v in d.get("window_labels", {}).items()},
            dropped_observations=tuple(d.get("dropped_observations", ())),
            latent_trace=dict(d.get("latent_trace", {})),
        )


# Field names that must never appear on the public inference object.
FORBIDDEN_INFERENCE_FIELDS: frozenset[str] = frozenset(
    {
        "label",
        "labels",
        "window_labels",
        "scenario",
        "scenario_id",
        "scenario_family",
        "family",
        "latent_effect",
        "event_effects",
        "progress",
        "latent_progress",
        "retry_policy",
        "oracle",
        "future_outcome",
    }
)
"""Per-event latent annotation contract (spec v0.2 §6.1).

Every generator (standard ``synth`` and the independently written ``synth_ood``)
emits one :class:`LatentStep` per canonical event. The window labeller
(:mod:`agent_loop_lab.synth.labeller`) derives oracle labels from these steps
alone, so labels mean the same thing whichever generator produced the session.

Nothing here is visible to the inference path: steps live in
``OracleRecord.latent_trace`` only.
"""

from __future__ import annotations

from dataclasses import asdict, dataclass
from typing import Any, Mapping, Sequence

from ..schema import LatentEffect, OracleRecord

EPISODE_KINDS = ("retry", "poll")


class LatentError(ValueError):
    """Raised when a latent trace violates the contract."""


@dataclass(frozen=True)
class LatentStep:
    """Latent state for one event, as known to the simulator.

    Fields:
        sequence_index: the event's ``sequence_index``.
        effect: §6.1 effect of this operation. ``REVERSION`` is set when the
            operation is a reversion relative to the window ending at this
            event; the labeller recomputes reversions per window from the
            workspace fields below, so this value is informational.
        progress_after: latent objective completion ``p`` after the operation, in [0, 1].
        new_facts: number of facts added to ``K`` by this operation (>= 0).
        ws_before / ws_after: opaque ids of the latent workspace content state
            before / after the operation (equal when nothing changed). These are
            latent: they stay correct even when the observed digests are dropped.
        agent_mutation: the agent's own operation changed the workspace
            (external resets are ``False``).
        undoes_prior_mutation: this mutation undoes an earlier agent mutation.
        open_episode_kind: ``"retry"`` / ``"poll"`` for the failure episode that
            is open (unresolved) **after** this operation, else ``None``.
        open_episode_attempts: retries (kind ``retry``) or polls (kind ``poll``)
            made so far in that open episode, counted after this operation; the
            initial failing operation counts 0.
        resolved_episode_here: this operation resolved a failure episode.
        dropped: the generator deliberately dropped a required observation on
            this event (scenario 12, rule 1).
    """

    sequence_index: int
    effect: LatentEffect
    progress_after: float
    new_facts: int
    ws_before: str
    ws_after: str
    agent_mutation: bool = False
    undoes_prior_mutation: bool = False
    open_episode_kind: str | None = None
    open_episode_attempts: int = 0
    resolved_episode_here: bool = False
    dropped: bool = False

    def __post_init__(self) -> None:
        object.__setattr__(self, "effect", LatentEffect(self.effect))
        if not isinstance(self.sequence_index, int) or self.sequence_index < 0:
            raise LatentError("sequence_index must be int >= 0")
        if not (0.0 <= float(self.progress_after) <= 1.0):
            raise LatentError(f"progress_after out of [0,1]: {self.progress_after}")
        if not isinstance(self.new_facts, int) or self.new_facts < 0:
            raise LatentError("new_facts must be int >= 0")
        if not (isinstance(self.ws_before, str) and isinstance(self.ws_after, str) and self.ws_before and self.ws_after):
            raise LatentError("ws_before/ws_after must be non-empty str")
        if self.open_episode_kind is not None and self.open_episode_kind not in EPISODE_KINDS:
            raise LatentError(f"open_episode_kind must be one of {EPISODE_KINDS} or None")
        if self.open_episode_kind is None and self.open_episode_attempts != 0:
            raise LatentError("open_episode_attempts must be 0 when no episode is open")
        if self.open_episode_attempts < 0:
            raise LatentError("open_episode_attempts must be >= 0")
        if self.undoes_prior_mutation and not self.agent_mutation:
            raise LatentError("undoes_prior_mutation requires agent_mutation")
        if self.agent_mutation and self.ws_before == self.ws_after:
            raise LatentError("agent_mutation requires ws_before != ws_after")

    def to_dict(self) -> dict[str, Any]:
        d = asdict(self)
        d["effect"] = self.effect.value
        return d

    @classmethod
    def from_dict(cls, d: Mapping[str, Any]) -> "LatentStep":
        return cls(**{**d, "effect": LatentEffect(d["effect"])})


def latent_trace(steps: Sequence[LatentStep], initial_progress: float) -> dict[str, Any]:
    """The ``OracleRecord.latent_trace`` payload for a session."""
    if not (0.0 <= float(initial_progress) <= 1.0):
        raise LatentError("initial_progress out of [0,1]")
    return {"initial_progress": float(initial_progress), "steps": [s.to_dict() for s in steps]}


def steps_from_record(record: OracleRecord) -> tuple[list[LatentStep], float]:
    """Recover (steps, initial_progress) from an OracleRecord."""
    trace = record.latent_trace
    try:
        steps = [LatentStep.from_dict(d) for d in trace["steps"]]
        p0 = float(trace["initial_progress"])
    except (KeyError, TypeError) as exc:
        raise LatentError(f"malformed latent_trace: {exc}") from exc
    return steps, p0
"""Window labeller: spec v0.2 §6.3 evaluated over latent steps (§6.1, §6.2).

Shared by every generator. Labels depend only on the latent trace and the
frozen oracle config, never on encoded features.
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Sequence

from ..oracle_config import OracleConfig, load_oracle_config
from ..schema import EVENTS_PER_WINDOW, LatentEffect, OracleLabel
from .latent import LatentError, LatentStep


@dataclass(frozen=True)
class WindowStats:
    """§6.3 quantities for one window (for labelling and diagnostics)."""

    start: int  # list position of the window's first event
    end: int  # list position of the window's last event (endpoint)
    delta_p: float
    facts: int  # F
    stall_ineffective: int  # I = REDUNDANT + window reversions
    reversions: int  # V
    final_stall_ineffective: bool
    episode_in_policy_at_end: bool
    resolved_recently: bool  # an episode resolved within the last k_rec events
    dropped: bool
    none_effects: int  # count of NONE effects (diagnostics: aimless activity)


def validate_steps(steps: Sequence[LatentStep], cfg: OracleConfig) -> None:
    """Check internal consistency of a session's latent trace."""
    for i, s in enumerate(steps):
        if i > 0 and s.sequence_index != steps[i - 1].sequence_index + 1:
            raise LatentError(f"non-dense sequence_index at position {i}")
        if i > 0 and s.ws_before != steps[i - 1].ws_after:
            raise LatentError(f"ws_before of step {s.sequence_index} != ws_after of previous step")
        limit = cfg.r_max if s.open_episode_kind == "retry" else cfg.p_max
        if s.effect is LatentEffect.IN_POLICY_RETRY and not (s.open_episode_kind == "retry" and 1 <= s.open_episode_attempts <= cfg.r_max):
            raise LatentError(f"step {s.sequence_index}: IN_POLICY_RETRY outside an in-policy retry episode")
        if s.effect is LatentEffect.IN_POLICY_POLL and not (s.open_episode_kind == "poll" and 1 <= s.open_episode_attempts <= cfg.p_max):
            raise LatentError(f"step {s.sequence_index}: IN_POLICY_POLL outside an in-policy poll episode")
        if s.effect is LatentEffect.RESOLVES_EPISODE and not s.resolved_episode_here:
            raise LatentError(f"step {s.sequence_index}: RESOLVES_EPISODE without resolved_episode_here")
        if s.open_episode_kind is not None and s.open_episode_attempts > limit and s.effect in (
            LatentEffect.IN_POLICY_RETRY,
            LatentEffect.IN_POLICY_POLL,
        ):
            raise LatentError(f"step {s.sequence_index}: out-of-policy attempt marked in-policy")
        if s.effect is LatentEffect.PROGRESS and i > 0 and not s.progress_after > steps[i - 1].progress_after:
            raise LatentError(f"step {s.sequence_index}: PROGRESS without a progress increase")
        if s.effect is LatentEffect.NEW_FACT and s.new_facts < 1:
            raise LatentError(f"step {s.sequence_index}: NEW_FACT with new_facts == 0")


def window_stats(
    steps: Sequence[LatentStep], initial_progress: float, end: int, cfg: OracleConfig
) -> WindowStats:
    """Compute §6.3 quantities for the window whose endpoint is list position ``end``."""
    if end < EVENTS_PER_WINDOW - 1 or end >= len(steps):
        raise IndexError(f"no full window ends at position {end}")
    start = end - EVENTS_PER_WINDOW + 1
    window = steps[start : end + 1]
    p_before = steps[start - 1].progress_after if start > 0 else float(initial_progress)
    delta_p = window[-1].progress_after - p_before

    seen = {window[0].ws_before}
    rev_flags: list[bool] = []
    for s in window:
        is_rev = s.agent_mutation and s.undoes_prior_mutation and s.ws_after in seen
        rev_flags.append(is_rev)
        seen.add(s.ws_before)
        seen.add(s.ws_after)
    stall_flags = [s.effect is LatentEffect.REDUNDANT or r for s, r in zip(window, rev_flags)]

    last = window[-1]
    in_policy = last.open_episode_kind is not None and last.open_episode_attempts <= (
        cfg.r_max if last.open_episode_kind == "retry" else cfg.p_max
    )
    recent = window[-cfg.k_rec :] if cfg.k_rec > 0 else []
    return WindowStats(
        start=start,
        end=end,
        delta_p=delta_p,
        facts=sum(s.new_facts for s in window),
        stall_ineffective=sum(stall_flags),
        reversions=sum(rev_flags),
        final_stall_ineffective=stall_flags[-1],
        episode_in_policy_at_end=in_policy,
        resolved_recently=any(s.resolved_episode_here for s in recent),
        dropped=any(s.dropped for s in window),
        none_effects=sum(s.effect is LatentEffect.NONE for s in window),
    )


def label_from_stats(st: WindowStats, cfg: OracleConfig) -> OracleLabel:
    """§6.3 rules 1-6, first match wins."""
    if st.dropped:  # rule 1
        return OracleLabel.INSUFFICIENT_INSTRUMENTATION
    if st.reversions >= cfg.n_rev and st.delta_p <= cfg.eps_p:  # rule 2
        return OracleLabel.OSCILLATING
    if (  # rule 3
        st.delta_p <= cfg.eps_p
        and st.facts == 0
        and st.stall_ineffective >= cfg.n_stall
        and st.final_stall_ineffective
        and not st.episode_in_policy_at_end
    ):
        return OracleLabel.STALLED
    if st.episode_in_policy_at_end or st.resolved_recently:  # rule 4
        return OracleLabel.RECOVERY
    if st.delta_p > cfg.eps_p or st.facts >= cfg.f_prod:  # rule 5
        return OracleLabel.PRODUCTIVE
    return OracleLabel.INSUFFICIENT_AMBIGUOUS  # rule 6


def label_session(
    steps: Sequence[LatentStep], initial_progress: float, cfg: OracleConfig | None = None
) -> dict[int, OracleLabel]:
    """Labels for every full window, keyed by the endpoint's ``sequence_index``."""
    cfg = cfg or load_oracle_config()
    validate_steps(steps, cfg)
    return {
        steps[t].sequence_index: label_from_stats(window_stats(steps, initial_progress, t, cfg), cfg)
        for t in range(EVENTS_PER_WINDOW - 1, len(steps))
    }
"""Pre-registered oracle parameters (spec v0.2 §6.2).

The frozen values live in ``oracle_config.v0_2.yaml`` at the repository root.
``load_oracle_config`` validates the exact key set, types and ranges, and
rejects duplicate keys, so a typo, a silently added parameter or a repeated one
fails loudly instead of changing labels.

File layout::

    spec_version: "0.2"
    approved: "2026-11-04"
    parameters:
      eps_p: 0.02
      f_prod: 2
      ...
"""

from __future__ import annotations

import math
import re
from dataclasses import asdict, dataclass, fields
from pathlib import Path
from typing import Any, Mapping

import yaml

from .schema import SPEC_VERSION

REPO_ROOT = Path(__file__).resolve().parents[2]
DEFAULT_CONFIG_PATH = REPO_ROOT / "oracle_config.v0_2.yaml"

TOP_LEVEL_KEYS = frozenset({"spec_version", "approved", "parameters"})
_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


class OracleConfigError(ValueError):
    """Raised when the oracle config file or values violate the contract."""


class _UniqueKeySafeLoader(yaml.SafeLoader):
    """SafeLoader that rejects duplicate mapping keys.

    Plain ``yaml.safe_load`` keeps the last of two equal keys, so a repeated
    parameter would silently override the value a reader sees first.
    """

    def construct_mapping(self, node: yaml.MappingNode, deep: bool = False) -> dict:
        seen: set[Any] = set()
        for key_node, _ in node.value:
            if key_node.tag == "tag:yaml.org,2002:merge":
                continue
            key = self.construct_object(key_node, deep=deep)
            try:
                duplicate = key in seen
            except TypeError:  # unhashable key: the base constructor reports it
                continue
            if duplicate:
                raise yaml.constructor.ConstructorError(
                    "while constructing a mapping", node.start_mark, f"found duplicate key {key!r}", key_node.start_mark
                )
            seen.add(key)
        return super().construct_mapping(node, deep=deep)


def _is_int(v: Any) -> bool:
    return isinstance(v, int) and not isinstance(v, bool)


@dataclass(frozen=True)
class OracleConfig:
    eps_p: float
    f_prod: int
    n_stall: int
    n_grey: int
    n_rev: int
    r_max: int
    p_max: int
    k_rec: int

    def __post_init__(self) -> None:
        eps = self.eps_p
        if isinstance(eps, bool) or not isinstance(eps, (int, float)):
            raise OracleConfigError(f"eps_p must be a number, got {type(eps).__name__}")
        eps = float(eps)
        if not math.isfinite(eps) or not (0.0 < eps < 1.0):
            raise OracleConfigError(f"eps_p must satisfy 0 < eps_p < 1, got {self.eps_p!r}")
        object.__setattr__(self, "eps_p", eps)
        for f in fields(self):
            if f.name == "eps_p":
                continue
            v = getattr(self, f.name)
            if not _is_int(v):
                raise OracleConfigError(f"{f.name} must be an int, got {type(v).__name__} ({v!r})")
        if not (0 <= self.n_grey < self.n_stall <= 8):
            raise OracleConfigError(
                f"require 0 <= n_grey < n_stall <= 8, got n_grey={self.n_grey}, n_stall={self.n_stall}"
            )
        if not (1 <= self.n_rev <= 8):
            raise OracleConfigError(f"require 1 <= n_rev <= 8, got {self.n_rev}")
        if not (0 <= self.k_rec <= 8):
            raise OracleConfigError(f"require 0 <= k_rec <= 8, got {self.k_rec}")
        # Not in the M0 contract's range list, but values outside these make the
        # §6.3 rules degenerate (F >= 0 is always true; negative budgets).
        if self.f_prod < 1:
            raise OracleConfigError(f"require f_prod >= 1, got {self.f_prod}")
        if self.r_max < 0:
            raise OracleConfigError(f"require r_max >= 0, got {self.r_max}")
        if self.p_max < 0:
            raise OracleConfigError(f"require p_max >= 0, got {self.p_max}")

    def to_dict(self) -> dict[str, Any]:
        return asdict(self)


PARAMETER_KEYS = frozenset(f.name for f in fields(OracleConfig))

FROZEN_V0_2 = OracleConfig(eps_p=0.02, f_prod=2, n_stall=5, n_grey=3, n_rev=2, r_max=3, p_max=5, k_rec=4)


def _check_keys(where: str, d: Mapping[str, Any], expected: frozenset[str]) -> None:
    keys = set(d)
    missing = sorted(expected - keys)
    extra = sorted(str(k) for k in keys - expected)
    if missing or extra:
        raise OracleConfigError(f"{where}: missing keys {missing}, unexpected keys {extra}")


def parse_oracle_config(data: Any) -> OracleConfig:
    """Validate an already-parsed YAML document and return the config."""
    if not isinstance(data, dict):
        raise OracleConfigError(f"oracle config must be a mapping, got {type(data).__name__}")
    _check_keys("oracle config", data, TOP_LEVEL_KEYS)
    if data["spec_version"] != SPEC_VERSION:
        raise OracleConfigError(
            f"spec_version must be the string {SPEC_VERSION!r} (quote it in YAML), got {data['spec_version']!r}"
        )
    approved = data["approved"]
    if not isinstance(approved, str) or not _DATE_RE.match(approved):
        raise OracleConfigError(f"approved must be a quoted 'YYYY-MM-DD' string, got {approved!r}")
    params = data["parameters"]
    if not isinstance(params, dict):
        raise OracleConfigError(f"parameters must be a mapping, got {type(params).__name__}")
    _check_keys("parameters", params, PARAMETER_KEYS)
    return OracleConfig(**params)


def load_oracle_config(path: str | Path | None = None) -> OracleConfig:
    """Load and validate the oracle config (default: repo-root ``oracle_config.v0_2.yaml``)."""
    p = Path(path) if path is not None else DEFAULT_CONFIG_PATH
    try:
        text = p.read_text(encoding="utf-8")
    except OSError as exc:
        raise OracleConfigError(f"cannot read oracle config {p}: {exc}") from exc
    try:
        data = yaml.load(text, Loader=_UniqueKeySafeLoader)  # noqa: S506 - SafeLoader subclass
    except yaml.YAMLError as exc:
        raise OracleConfigError(f"invalid YAML in {p}: {exc}") from exc
    return parse_oracle_config(data)
"""Windowing, sequence validation and the runtime evidence gate (spec v0.2 §5; M0 contracts §B).

The gate is purely about instrumentation: it makes **no semantic judgement**.
A window of eight novel, fully instrumented INSPECT events passes.
"""

from __future__ import annotations

from dataclasses import dataclass
from enum import Enum
from typing import Iterator, Sequence

import numpy as np

from .encode import encode_window, validation_baseline
from .schema import EVENTS_PER_WINDOW, INPUT_DIM, CanonicalEvent, Outcome

__all__ = [
    "INSUFFICIENT_EVIDENCE",
    "PASS",
    "SequenceError",
    "GateReason",
    "GateDecision",
    "WindowResult",
    "validate_sequence",
    "gate",
    "window_endpoints",
    "iter_windows",
    "encode_session",
]

INSUFFICIENT_EVIDENCE = "INSUFFICIENT_EVIDENCE"
PASS = "PASS"


class SequenceError(ValueError):
    """Raised when an event list is not one dense, ordered (session, agent, task) stream."""


class GateReason(str, Enum):
    TOO_SHORT = "TOO_SHORT"
    MISSING_TOKENS = "MISSING_TOKENS"
    MISSING_WORKSPACE_DIGEST = "MISSING_WORKSPACE_DIGEST"
    MISSING_FAILURE_FINGERPRINT = "MISSING_FAILURE_FINGERPRINT"
    MISSING_VALIDATION_FIELDS = "MISSING_VALIDATION_FIELDS"
    UNOBSERVED_VALIDATION_BASELINE = "UNOBSERVED_VALIDATION_BASELINE"


@dataclass(frozen=True)
class GateDecision:
    passed: bool
    reasons: tuple[tuple[int, GateReason], ...] = ()

    def __post_init__(self) -> None:
        if self.passed != (len(self.reasons) == 0):
            raise ValueError("GateDecision.passed must be True iff there are no reasons")

    @property
    def result(self) -> str:
        return PASS if self.passed else INSUFFICIENT_EVIDENCE


@dataclass(frozen=True)
class WindowResult:
    endpoint_index: int  # sequence_index of the window's last event
    gate: GateDecision
    features: np.ndarray | None  # (120,) float32 when gate passed, else None


def validate_sequence(events: Sequence[CanonicalEvent]) -> None:
    """Raise :class:`SequenceError` unless ``events`` is one dense ordered stream."""
    events = list(events)
    if not events:
        return
    for ev in events:
        if not isinstance(ev, CanonicalEvent):
            raise SequenceError(f"not a CanonicalEvent: {type(ev).__name__}")
    first = events[0]
    for name in ("session_id", "agent_id", "task_id"):
        values = {getattr(ev, name) for ev in events}
        if len(values) != 1:
            raise SequenceError(f"mixed {name}: {sorted(values)}")
    ids = [ev.event_id for ev in events]
    if len(set(ids)) != len(ids):
        dup = sorted({i for i in ids if ids.count(i) > 1})
        raise SequenceError(f"duplicate event_id(s): {dup}")
    for prev, cur in zip(events, events[1:]):
        if cur.sequence_index != prev.sequence_index + 1:
            raise SequenceError(
                f"sequence_index must increase by exactly 1: {prev.sequence_index} -> {cur.sequence_index}"
            )
    if first.provenance.history_complete and first.sequence_index != 0:
        raise SequenceError(
            f"history_complete session must start at sequence_index 0, starts at {first.sequence_index}"
        )


def gate(prefix: Sequence[CanonicalEvent]) -> GateDecision:
    """Runtime evidence gate (spec §5.2) for the window ending at the last event of ``prefix``."""
    events = list(prefix)
    n = len(events)
    if n < EVENTS_PER_WINDOW:
        return GateDecision(False, ((-1, GateReason.TOO_SHORT),))
    start = n - EVENTS_PER_WINDOW
    reasons: set[tuple[int, GateReason]] = set()
    for pos in range(EVENTS_PER_WINDOW):
        k = start + pos
        ev = events[k]
        if ev.input_tokens is None or ev.output_tokens is None:
            reasons.add((pos, GateReason.MISSING_TOKENS))
        if ev.workspace_state_before is None or ev.workspace_state_after is None:
            reasons.add((pos, GateReason.MISSING_WORKSPACE_DIGEST))
        if ev.outcome is Outcome.ERROR and ev.failure_fingerprint is None:
            reasons.add((pos, GateReason.MISSING_FAILURE_FINGERPRINT))
        if ev.validation_produced:
            if ev.validation_suite_id is None or ev.validation_passed is None or ev.validation_total is None:
                reasons.add((pos, GateReason.MISSING_VALIDATION_FIELDS))
            if ev.validation_suite_id is not None:
                _, observed = validation_baseline(events, k)
                if not observed:
                    reasons.add((pos, GateReason.UNOBSERVED_VALIDATION_BASELINE))
    ordered = tuple(sorted(reasons, key=lambda r: (r[0], r[1].value)))
    return GateDecision(not ordered, ordered)


def window_endpoints(events: Sequence[CanonicalEvent]) -> list[int]:
    """List positions ``t >= 7`` that end a full window."""
    return list(range(EVENTS_PER_WINDOW - 1, len(events)))


def iter_windows(events: Sequence[CanonicalEvent]) -> Iterator[WindowResult]:
    """Validate once, then gate and (if passed) encode each stride-1 window.

    Each window sees only ``events[:t+1]``; nothing after the endpoint is read.
    """
    events = list(events)
    validate_sequence(events)
    for t in window_endpoints(events):
        prefix = events[: t + 1]
        decision = gate(prefix)
        features = encode_window(prefix) if decision.passed else None
        yield WindowResult(endpoint_index=prefix[-1].sequence_index, gate=decision, features=features)


def encode_session(events: Sequence[CanonicalEvent]) -> tuple[list[int], np.ndarray]:
    """Endpoints (``sequence_index``) of passing windows and their stacked ``(n, 120)`` float32 features."""
    endpoints: list[int] = []
    rows: list[np.ndarray] = []
    for w in iter_windows(events):
        if w.gate.passed:
            endpoints.append(w.endpoint_index)
            rows.append(w.features)
    if not rows:
        return endpoints, np.zeros((0, INPUT_DIM), dtype=np.float32)
    return endpoints, np.ascontiguousarray(np.stack(rows), dtype=np.float32)

