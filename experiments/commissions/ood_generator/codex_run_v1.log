@@ -0,0 +1,151 @@
+"""Independent OOD session families. Only shared contracts/oracle are reused.
+
+Each callable accepts (random.Random, session_id, OracleConfig). Intended
+scored labels are stated in its docstring; ambiguous transition windows are
+preserved. All session choices and costs consume only the supplied RNG.
+"""
+
+from collections.abc import Callable
+import random
+
+from ..oracle_config import OracleConfig
+from ..schema import CanonicalEvent, OracleRecord
+from .engine import Engine
+
+
+def _repair(e: Engine, count: int) -> None:
+    paths = e.rng.sample(e.repo.paths, count)
+    for path in paths:
+        e.read(path)
+        e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
+        e.test()
+
+
+def shard_migration(rng, session_id, cfg):
+    """PRODUCTIVE: repair separate shard contracts, with validation between writes."""
+    e = Engine(rng, session_id, cfg)
+    e.test()
+    _repair(e, rng.randint(8, len(e.repo.paths)))
+    return e.finish("shard_migration")
+
+
+def fixture_archaeology(rng, session_id, cfg):
+    """PRODUCTIVE: discover paired predicate/fixture facts before repairing anything."""
+    e = Engine(rng, session_id, cfg)
+    for path in rng.sample(e.repo.paths, len(e.repo.paths)):
+        e.read(path)
+        # Interleave a distinct material source with a first-time control step.
+        e.perform("plan", args={"action_type": f"inspect:{path}"})
+    _repair(e, rng.randint(3, 7))
+    return e.finish("fixture_archaeology")
+
+
+def lease_reconnect(rng, session_id, cfg):
+    """RECOVERY and PRODUCTIVE: renewing mirror leases after peer resets."""
+    e = Engine(rng, session_id, cfg)
+    _repair(e, 3)
+    for i in range(rng.randint(3, 6)):
+        host = f"mirror-{i}.cedar.invalid"
+        e.service(host, "retry", rng.randint(2, 3))
+        target = {"method": "POST", "host": host, "path_template": "/lease/{key}"}
+        for _ in range(e.services[host][1] + 1):
+            e.perform("http_call", target, {"body": '{"lease":"replica"}'})
+    _repair(e, 3)
+    return e.finish("lease_reconnect")
+
+
+def index_watermark(rng, session_id, cfg):
+    """RECOVERY and PRODUCTIVE: wait for replicated indexes using bounded polls."""
+    e = Engine(rng, session_id, cfg)
+    _repair(e, 3)
+    for i in range(rng.randint(3, 5)):
+        resource = f"index:quorum:{i}"
+        e.service(resource, "poll", rng.randint(3, 5))
+        for attempt in range(e.services[resource][1] + 1):
+            e.perform("poll_status", resource, {"backoff": 2**attempt})
+    _repair(e, 3)
+    return e.finish("index_watermark")
+
+
+def pinned_validation(rng, session_id, cfg):
+    """RECOVERY and STALLED: endlessly rerun a deterministic replica assertion."""
+    e = Engine(rng, session_id, cfg)
+    for _ in range(rng.randint(25, 86)):
+        e.test()
+    return e.finish("pinned_validation")
+
+
+def annotation_spiral(rng, session_id, cfg):
+    """STALLED: unique commentary writes preserve the broken executable contract."""
+    e = Engine(rng, session_id, cfg)
+    path = rng.choice(e.repo.paths)
+    base = e.repo.files[path]
+    e.test()
+    for i in range(rng.randint(12, 39)):
+        e.write(path, base + f"# explanation {i}: ticket {rng.randrange(1000000)}\n")
+        e.test()
+    return e.finish("annotation_spiral")
+
+
+def serializer_duel(rng, session_id, cfg):
+    """OSCILLATING: two emitters repeatedly restore opposing wire conventions."""
+    e = Engine(rng, session_id, cfg)
+    path = rng.choice(e.repo.paths)
+    left = e.repo.files[path]
+    right = left.replace("mode=left", "mode=right")
+    for i in range(rng.randint(24, 80)):
+        e.write(path, right if i % 2 == 0 else left)
+    return e.finish("serializer_duel")
+
+
+def merge_ping_pong(rng, session_id, cfg):
+    """OSCILLATING: conflict resolution alternates local and upstream ownership.
+
+    Absent from §7.1: a merge workflow, rather than alternative bug fixes.
+    """
+    e = Engine(rng, session_id, cfg)
+    path = "config/merge.conf"
+    for i in range(rng.randint(12, 29)):
+        e.write(path, "owner=upstream\n" if i % 2 == 0 else "owner=local\n")
+        e.perform("plan", args={"action_type": "reconcile-ownership"})
+    return e.finish("merge_ping_pong")
+
+
+def lockfile_churn(rng, session_id, cfg):
+    """OSCILLATING: installer and resolver pin incompatible dependency versions.
+
+    Absent from §7.1: dependency resolution churn with no repaired contracts.
+    """
+    e = Engine(rng, session_id, cfg)
+    path = "config/replica.lock"
+    for i in range(rng.randint(12, 36)):
+        e.write(path, f"package=cedar\nversion={2 if i % 2 == 0 else 1}\n")
+        e.read(path)
+    return e.finish("lockfile_churn")
+
+
+def telemetry_gaps(rng, session_id, cfg):
+    """PRODUCTIVE plus rejected windows: independent digest/token/failure loss.
+
+    Only non-baseline observations are dropped, so rejection ends exactly when
+    the affected event leaves the window. The underlying repository is intact.
+    """
+    e = Engine(rng, session_id, cfg)
+    _repair(e, 3)
+    e.test(dropped="failure")
+    _repair(e, 3)
+    e.perform("read_file", e.repo.paths[0], dropped="workspace")
+    _repair(e, 3)
+    e.perform("plan", args={"action_type": "audit-transport"}, dropped="tokens")
+    _repair(e, 3)
+    return e.finish("telemetry_gaps")
+
+
+FAMILIES: dict[str, Callable[[random.Random, str, OracleConfig],
+                           tuple[list[CanonicalEvent], OracleRecord]]] = {
+    f.__name__: f for f in (
+        shard_migration, fixture_archaeology, lease_reconnect, index_watermark,
+        pinned_validation, annotation_spiral, serializer_duel, merge_ping_pong,
+        lockfile_churn, telemetry_gaps,
+    )
+}
