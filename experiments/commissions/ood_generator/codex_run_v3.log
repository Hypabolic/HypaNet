"""Acceptance coverage across independent seeds, plus causal engine checks."""

import json
import random

import numpy as np
import pytest

from agent_loop_lab.encode import encode_window
from agent_loop_lab.fingerprint import FAMILY_CATEGORY, workspace_digest
from agent_loop_lab.oracle_config import load_oracle_config
from agent_loop_lab.schema import CanonicalEvent, LatentEffect as E, OracleLabel as L, OracleRecord
from agent_loop_lab.synth.labeller import label_session, validate_steps
from agent_loop_lab.synth.latent import steps_from_record
from agent_loop_lab.synth_ood import FAMILIES
from agent_loop_lab.synth_ood.engine import Engine
from agent_loop_lab.synth_ood.counterfactuals import counterfactual_pairs
from agent_loop_lab.windows import GateReason, gate, iter_windows, validate_sequence


CFG = load_oracle_config("oracle_config.v0_2.yaml")
INTENDED = {
    "shard_migration": {L.PRODUCTIVE, L.RECOVERY},
    "fixture_archaeology": {L.PRODUCTIVE, L.STALLED},
    "lease_reconnect": {L.PRODUCTIVE, L.RECOVERY},
    "index_watermark": {L.PRODUCTIVE, L.RECOVERY},
    "pinned_validation": {L.PRODUCTIVE, L.RECOVERY, L.STALLED},
    "annotation_spiral": {L.STALLED, L.PRODUCTIVE},
    "serializer_duel": {L.OSCILLATING, L.PRODUCTIVE},
    "merge_ping_pong": {L.OSCILLATING, L.PRODUCTIVE},
    "lockfile_churn": {L.OSCILLATING, L.PRODUCTIVE},
    "telemetry_gaps": {L.PRODUCTIVE},
}


@pytest.mark.parametrize("name", FAMILIES)
@pytest.mark.parametrize("seed", range(24))
def test_session_contract(name, seed):
    generate = FAMILIES[name]
    events, oracle = generate(random.Random(seed), "session-17", CFG)
    other_events, other_oracle = generate(random.Random(seed), "session-17", CFG)
    assert [e.to_json() for e in events] == [e.to_json() for e in other_events]
    assert json.dumps(oracle.to_dict(), sort_keys=True) == json.dumps(other_oracle.to_dict(), sort_keys=True)
    assert OracleRecord.from_dict(oracle.to_dict()) == oracle
    assert 20 <= len(events) <= 90
    assert oracle.generator_version == "ood-0.1"
    assert oracle.scenario_family == f"ood:{name}"
    steps, p0 = steps_from_record(oracle)
    validate_steps(steps, CFG)
    validate_sequence(events)
    assert len(steps) == len(events)
    assert label_session(steps, p0, CFG) == oracle.window_labels
    assert tuple(s.effect for s in steps) == oracle.event_effects
    assert tuple(s.sequence_index for s in steps if s.dropped) == oracle.dropped_observations
    assert INTENDED[name] <= set(oracle.window_labels.values())
    assert all(label.value in generate.__doc__ for label in INTENDED[name])
    for event, step in zip(events, steps):
        assert CanonicalEvent.from_json(event.to_json()) == event
        assert event.operation_category == FAMILY_CATEGORY[event.operation_family]
        assert event.sequence_index == step.sequence_index
        assert event.session_id == oracle.session_id
        if not step.dropped:
            assert event.workspace_state_before == step.ws_before
            assert event.workspace_state_after == step.ws_after
        if step.agent_mutation:
            assert step.ws_before != step.ws_after
        assert event.provenance.source == "simulator:ood-0.1"
        assert not event.provenance.instrumentation_flags
        assert name not in event.to_json()
    for result in iter_windows(events):
        t = result.endpoint_index
        dropped = any(s.dropped for s in steps[t-7:t+1])
        assert result.gate.passed == (not dropped)
        assert (oracle.window_labels[t] == L.INSUFFICIENT_INSTRUMENTATION) == dropped
        if result.gate.passed:
            assert result.features.shape == (120,)
            assert result.features.dtype == np.float32
            assert np.isfinite(result.features).all()
        else:
            assert name == "telemetry_gaps"
            assert result.features is None


@pytest.mark.parametrize("name", FAMILIES)
def test_rng_controls_variation(name):
    sessions = [FAMILIES[name](random.Random(i), "s", CFG)[0] for i in range(8)]
    assert len({len(events) for events in sessions}) > 1 or name == "telemetry_gaps"
    assert len({events[0].to_json() for events in sessions}) > 1


def engine(seed=1):
    return Engine(random.Random(seed), "causal", CFG)


def test_real_text_drives_progress_validation_and_digest():
    e = engine()
    path = e.repo.paths[0]
    e.test()
    old = e.repo.digest()
    e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
    e.test()
    assert e.events[0].validation_passed == 0
    assert e.events[-1].validation_passed == 1
    assert e.steps[1].effect == E.PROGRESS
    assert e.steps[2].effect == E.NONE
    assert e.steps[1].progress_after == 1 / len(e.repo.paths)
    assert old != e.repo.digest() == workspace_digest(e.repo.files)
    assert e.events[-1].workspace_state_after == e.repo.digest()


def test_facts_and_cosmetic_writes_are_not_progress():
    e = engine()
    path = e.repo.paths[0]
    e.read(path)
    e.read(path)
    e.write(path, e.repo.files[path] + "# formatting only\n")
    assert [s.effect for s in e.steps] == [E.NEW_FACT, E.REDUNDANT, E.REDUNDANT]
    assert [s.new_facts for s in e.steps] == [2, 0, 0]
    assert all(s.progress_after == 0 for s in e.steps)
    assert e.steps[-1].agent_mutation


def test_retry_budget_and_episode_resolution():
    e = engine()
    e.service("peer.cedar.invalid", "retry", 5)
    target = {"method": "GET", "host": "peer.cedar.invalid", "path_template": "/lease"}
    for _ in range(6):
        e.perform("http_call", target)
    assert [s.effect for s in e.steps] == [E.NONE] + [E.IN_POLICY_RETRY]*3 + [E.REDUNDANT, E.RESOLVES_EPISODE]
    assert e.steps[0].open_episode_kind is None
    assert e.steps[1].open_episode_attempts == 1
    assert e.steps[-1].open_episode_kind is None
    assert e.steps[-1].resolved_episode_here
    # New service knowledge is recorded even though resolution has precedence.
    assert e.steps[-1].new_facts == 1


def test_poll_budget_ignores_backoff_metadata():
    e = engine()
    e.service("index:42", "poll", 7)
    for i in range(8):
        e.perform("poll_status", "index:42", {"backoff": 2**i})
    assert [s.effect for s in e.steps] == [E.NONE] + [E.IN_POLICY_POLL]*5 + [E.REDUNDANT, E.RESOLVES_EPISODE]
    assert len({ev.intent_fingerprint for ev in e.events}) == 1


def test_episode_abandonment_and_cosmetic_validation():
    e = engine()
    e.test()
    e.test()
    assert e.steps[-1].open_episode_kind == "retry"
    path = e.repo.paths[0]
    e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
    assert e.steps[-1].open_episode_kind is None
    assert e.steps[-1].effect == E.PROGRESS
    e.test()
    e.test()
    e.perform("plan", args={"action_type": "consider"})
    assert e.steps[-1].open_episode_kind == "retry"
    e.perform("plan", args={"action_type": "consider-more"})
    assert e.steps[-1].open_episode_kind is None
    e.write(path, e.repo.files[path] + "# pretty\n")
    e.test()
    assert e.steps[-1].effect == E.REDUNDANT


def test_reversion_and_restored_progress_are_derived():
    e = engine()
    path = e.repo.paths[0]
    original = e.repo.files[path]
    e.write(path, original.replace("enabled=0", "enabled=1"))
    e.write(path, original)
    e.write(path, original.replace("enabled=0", "enabled=1"))
    assert [s.effect for s in e.steps] == [E.PROGRESS, E.REVERSION, E.PROGRESS]
    assert e.steps[-1].undoes_prior_mutation  # progress outranks reversion
    validate_steps(e.steps, CFG)


def test_dropped_reason_coverage_and_recovery_after_gap():
    events, oracle = FAMILIES["telemetry_gaps"](random.Random(9), "s", CFG)
    reasons = {reason for t in range(7, len(events)) for _, reason in gate(events[:t+1]).reasons}
    assert reasons == set(GateReason) - {GateReason.TOO_SHORT}
    for i in oracle.dropped_observations:
        assert not gate(events[:i+1]).passed
    # A burst may contain several overlapping losses, including a result whose
    # own fields are complete but whose baseline was lost. Rejection ends when
    # the final affected event leaves the window.
    last = max(oracle.dropped_observations)
    assert not gate(events[:last+8]).passed
    assert gate(events[:last+9]).passed


def test_encoding_is_prefix_causal():
    events, _ = FAMILIES["shard_migration"](random.Random(2), "s", CFG)
    first = encode_window(events[:8]).tobytes()
    list(iter_windows(events))
    assert encode_window(events[:8]).tobytes() == first


@pytest.mark.parametrize("seed", range(8))
def test_identical_category_outcome_sequences_can_have_opposite_labels(seed):
    productive, good_oracle = FAMILIES["shard_migration"](random.Random(seed), "same", CFG)
    stalled, bad_oracle = FAMILIES["annotation_spiral"](random.Random(seed), "same", CFG)
    # Both start with a failure and eight write/failing-test cycles. Only the
    # causal contents distinguish real repairs from inert annotation writes.
    assert [(e.operation_category, e.outcome) for e in productive[:17]] == [
        (e.operation_category, e.outcome) for e in stalled[:17]
    ]
    assert good_oracle.window_labels[16] == L.PRODUCTIVE
    assert bad_oracle.window_labels[16] == L.STALLED


@pytest.mark.parametrize("seed", range(8))
def test_causal_counterfactual_pairs(seed):
    pairs = counterfactual_pairs(random.Random(seed), "paired", CFG)
    repeated = counterfactual_pairs(random.Random(seed), "paired", CFG)
    expected = {"service_persistence": L.STALLED, "edit_annotation": L.STALLED,
                "edit_reversal": L.OSCILLATING}
    for name, (good, bad) in pairs.items():
        assert [e.to_json() for e in good[0][:9]] == [e.to_json() for e in bad[0][:9]]
        assert len(good[0]) == len(bad[0])
        assert good[1].window_labels[len(good[0])-1] == L.PRODUCTIVE
        assert bad[1].window_labels[len(bad[0])-1] == expected[name]
        for branch, again in zip((good, bad), repeated[name]):
            events, oracle = branch
            assert [e.to_json() for e in events] == [e.to_json() for e in again[0]]
            assert oracle.to_dict() == again[1].to_dict()
            validate_sequence(events)
            steps, p0 = steps_from_record(oracle)
            validate_steps(steps, CFG)
            assert label_session(steps, p0, CFG) == oracle.window_labels
            assert all(w.gate.passed for w in iter_windows(events))
"""Revision acceptance audit on the commissioned seeds 0 through 49."""

from itertools import groupby
import random

import pytest

from agent_loop_lab.oracle_config import load_oracle_config
from agent_loop_lab.schema import OracleLabel as L
from agent_loop_lab.synth.labeller import label_session, validate_steps
from agent_loop_lab.synth.latent import steps_from_record
from agent_loop_lab.synth_ood import FAMILIES
from agent_loop_lab.synth_ood.engine import Engine
from agent_loop_lab.windows import GateReason, gate, validate_sequence


CFG = load_oracle_config("oracle_config.v0_2.yaml")


@pytest.fixture(scope="module")
def corpus():
    # Reuse these sessions across audits; no encoder runs or seed searching.
    return {name: [generate(random.Random(seed), "revision-audit", CFG)
                   for seed in range(50)] for name, generate in FAMILIES.items()}


@pytest.mark.parametrize("name", FAMILIES)
def test_structural_variety_over_fifty_seeds(corpus, name):
    shapes = [tuple((event.operation_family, event.outcome) for event in events)
              for events, _ in corpus[name]]
    assert len(set(shapes)) >= 40
    # Also vary operation order, rather than only the length of repeated runs.
    assert len({tuple(key for key, _ in groupby(shape)) for shape in shapes}) >= 10
    assert len({len(shape) for shape in shapes}) >= 5


@pytest.mark.parametrize("name", FAMILIES)
def test_every_session_mixes_scored_behaviours(corpus, name):
    for events, record in corpus[name]:
        assert 20 <= len(events) <= 90
        assert len({label for label in record.window_labels.values() if label.is_scored}) >= 2
        steps, p0 = steps_from_record(record)
        validate_sequence(events)
        validate_steps(steps, CFG)
        assert label_session(steps, p0, CFG) == record.window_labels


def _contains_in_order(labels, expected):
    remaining = iter(labels)
    return all(any(actual == desired for actual in remaining) for desired in expected)


@pytest.mark.parametrize("name,expected", [
    ("shard_migration", [L.PRODUCTIVE, L.RECOVERY, L.PRODUCTIVE]),
    ("fixture_archaeology", [L.PRODUCTIVE, L.STALLED, L.PRODUCTIVE]),
    ("lease_reconnect", [L.PRODUCTIVE, L.RECOVERY, L.PRODUCTIVE]),
    ("index_watermark", [L.PRODUCTIVE, L.RECOVERY, L.PRODUCTIVE]),
    ("pinned_validation", [L.PRODUCTIVE, L.RECOVERY, L.STALLED, L.PRODUCTIVE]),
    ("annotation_spiral", [L.STALLED, L.PRODUCTIVE]),
    ("serializer_duel", [L.OSCILLATING, L.PRODUCTIVE]),
    ("merge_ping_pong", [L.PRODUCTIVE, L.OSCILLATING, L.PRODUCTIVE]),
    ("lockfile_churn", [L.PRODUCTIVE, L.OSCILLATING, L.PRODUCTIVE]),
])
def test_behaviour_transitions_follow_real_work(corpus, name, expected):
    for _, record in corpus[name]:
        assert _contains_in_order(record.window_labels.values(), expected)
        steps, _ = steps_from_record(record)
        # The resumed productive work includes actual repairs, not only facts.
        last_problem = max(t for t, label in record.window_labels.items()
                           if label == expected[-2])
        assert any(steps[i].progress_after > steps[i-1].progress_after
                   for i in range(last_problem + 1, len(steps)))


def test_ambiguous_boundary_windows_are_retained(corpus):
    families = {name for name, sessions in corpus.items()
                if any(L.INSUFFICIENT_AMBIGUOUS in record.window_labels.values()
                       for _, record in sessions)}
    assert len(families) >= 3
    # Depending on phase alignment, recovery can turn directly into a stall.
    # Require ambiguous boundaries in the corpus without forcing every seed
    # to traverse the same label schedule.
    assert any(_contains_in_order(record.window_labels.values(),
                                  [L.PRODUCTIVE, L.INSUFFICIENT_AMBIGUOUS,
                                   L.STALLED, L.PRODUCTIVE])
               for _, record in corpus["pinned_validation"])


@pytest.mark.parametrize("opponent,label", [
    ("annotation_spiral", L.STALLED), ("serializer_duel", L.OSCILLATING),
])
def test_two_benign_lookalike_pairs(corpus, opponent, label):
    for (good_events, good), (bad_events, bad) in zip(
            corpus["shard_migration"], corpus[opponent]):
        # These are full, scored eight-event windows, not just similar counts.
        good_window, bad_window = good_events[9:17], bad_events[9:17]
        assert [(e.operation_category, e.outcome) for e in good_window] == [
            (e.operation_category, e.outcome) for e in bad_window]
        assert good.window_labels[16] == L.PRODUCTIVE
        assert bad.window_labels[16] == label
        good_steps, _ = steps_from_record(good)
        bad_steps, _ = steps_from_record(bad)
        assert good_steps[16].progress_after > good_steps[8].progress_after
        assert bad_steps[16].progress_after == bad_steps[8].progress_after
        assert gate(good_events[:17]).passed and gate(bad_events[:17]).passed


def test_telemetry_samples_several_behaviours_and_every_drop_kind(corpus):
    clean_classes = set()
    external_tools = set()
    for events, record in corpus["telemetry_gaps"]:
        steps, _ = steps_from_record(record)
        assert tuple(i for i, step in enumerate(steps) if step.dropped) == record.dropped_observations
        reasons = set()
        classes = set()
        for t in range(7, len(events)):
            decision = gate(events[:t+1])
            reasons.update(reason for _, reason in decision.reasons)
            dropped = any(step.dropped for step in steps[t-7:t+1])
            assert decision.passed == (not dropped)
            assert (record.window_labels[t] == L.INSUFFICIENT_INSTRUMENTATION) == dropped
            if decision.passed and record.window_labels[t].is_scored:
                classes.add(record.window_labels[t])
        assert reasons == set(GateReason) - {GateReason.TOO_SHORT}
        assert L.PRODUCTIVE in classes and len(classes) >= 2
        clean_classes.update(classes)
        external_tools.update(e.operation_family for e in events
                              if e.operation_family in ("http_call", "poll_status"))
        assert gate(events[:max(record.dropped_observations)+9]).passed
        for field in ("validation_suite_id", "validation_passed", "validation_total"):
            assert any(e.validation_produced and getattr(e, field) is None for e in events)
        assert gate(events[:7]).reasons == ((-1, GateReason.TOO_SHORT),)
    assert clean_classes == {L.PRODUCTIVE, L.RECOVERY, L.STALLED, L.OSCILLATING}
    assert external_tools == {"http_call", "poll_status"}


@pytest.mark.parametrize("field", ["validation_suite", "validation_passed", "validation_total"])
def test_lost_validation_baseline_marks_only_affected_observations(field):
    clean = Engine(random.Random(7), "baseline", CFG)
    lossy = Engine(random.Random(7), "baseline", CFG)
    for e in (clean, lossy):
        e.test()
        e.test(dropped=field if e is lossy else None)
        e.test()
        e.test()
        for i in range(8):
            e.perform("plan", args={"action_type": f"review:{i}"})
    assert [s.sequence_index for s in lossy.steps if s.dropped] == [1, 2]
    assert all(getattr(lossy.events[2], f) is not None for f in
               ("validation_suite_id", "validation_passed", "validation_total"))
    for a, b in zip(clean.steps, lossy.steps):
        assert {k: v for k, v in a.to_dict().items() if k != "dropped"} == {
            k: v for k, v in b.to_dict().items() if k != "dropped"}
    for t in range(7, len(lossy.events)):
        assert gate(lossy.events[:t+1]).passed == (t >= 10)
    assert clean.repo.files == lossy.repo.files
# Independent OOD generator 0.1 — revision 1

`agent_loop_lab.synth_ood.FAMILIES` exposes ten callables accepting
`(rng: random.Random, session_id: str, cfg: OracleConfig)` and returning
`(list[CanonicalEvent], OracleRecord)`. The API and generator version remain
unchanged. Only this commission directory was consulted; no standard generator,
datasets, classifiers, weights or network services were used.

## World and causal model

`engine.py` maintains an in-memory repository with actual text contents. A
small contract language interprets `enabled=1` as a satisfied shard predicate
and `enabled=0` as a fault. Each shard also has a deployment `mode`. Comments
are behaviourally inert. Progress is the fraction of satisfied contracts;
validation counts come from the same predicates. This is a simulated language
interpreter, not execution of Elixir, Zig, Lua or Clojure. Those extensions and
suite names provide varied tool vocabulary.

Inspecting an unexplored contract reveals its predicate and fixture, adding
two material facts. The engine tracks knowledge, read history, behavioural
validation history, controls, workspace contents, one active failure episode,
and independent mirror/index readiness counters. Request bodies distinguish
service retries; backoff metadata does not. Service success reveals lease
knowledge without repairing repository faults.

Effects follow the binding latent-effect rules. The first failure opens no
episode. An exact consecutive retry opens one; retries and polls consume the
config's budgets. Success resolves the episode. A relevant behavioural change
or two unrelated operations abandon it. Progress belongs to the mutation that
repairs a predicate. Comments remain redundant despite changing digests.
Restoring earlier contents records an undo; the shared labeller recomputes
reversions within each window. Progress, facts and undo flags remain recorded
even when another effect takes precedence.

Fingerprints and digests use the shared fingerprint module. Public events
contain no scenario tags or hidden effects. Callers should supply opaque
session IDs. Sealed records use `generator_version="ood-0.1"`,
`scenario_family="ood:<name>"`, `latent_trace` and `label_session`. Scripts
choose operations, never effects or labels, and do not consult encoded
features. `OracleRecord.seed` is a nonce drawn from the supplied RNG, not the
caller's original seed; replay requires that original seed or saved RNG state.

## Families and intended labels

The labels below are minimum coverage per session under frozen v0.2 parameters,
except telemetry's additional classes depend on its sampled workflows.
Optional phases can add other labels. Ambiguous windows are retained.

| Family | Intended scored labels | Mechanics and difference from §7.1 |
|---|---|---|
| `shard_migration` | PRODUCTIVE, RECOVERY | Eight independent shard repairs precede one to three retry/poll episodes. Optional commentary can stall; actual repairs resume afterward. Reimagines incremental repair and improving validation (§7.1.1, 9) as distributed migration interrupted by quorum acquisition. |
| `fixture_archaeology` | PRODUCTIVE, STALLED | Discover five to eight predicates/fixtures, optionally attempt a repair, then pursue inert documentation before repairing real faults. Reimagines exploration (§7.1.2) as an investigation with a dead end. |
| `lease_reconnect` | PRODUCTIVE, RECOVERY | Repairs surround two to four mirror outages. Optional investigation and a watermark wait add another external phase. Reimagines transient failures and bounded retries (§7.1.3, 4) as multi-host lease acquisition. |
| `index_watermark` | PRODUCTIVE, RECOVERY | Two to four neutral not-ready episodes have variable delays, with optional repairs between waits. Backoff does not distinguish intents. Reimagines polling (§7.1.10) as replicated-index maintenance. |
| `pinned_validation` | PRODUCTIVE, RECOVERY, STALLED | Useful repair precedes 14–24 unchanged failing validations. Early retries are in policy; later retries stall. Optional discovery and actual repairs break the loop. Reimagines §7.1.5 as a pinned replica assertion. |
| `annotation_spiral` | STALLED, PRODUCTIVE | Eight comment/test cycles change text without progress. Optional further notes precede actual predicate repairs; an optional lease outage and more repair extend the session. Reimagines ineffective edits and rising expenditure (§7.1.6, 11). |
| `serializer_duel` | OSCILLATING, PRODUCTIVE | Opposing emitters restore concrete wire conventions. Variable continuation intersperses inspections, plans and tests. Optional recovery precedes real repairs that end the oscillation. Reimagines workspace/tool oscillation (§7.1.7, 8). |
| `merge_ping_pong` | PRODUCTIVE, OSCILLATING | Repairs precede 10–16 competing ownership resolutions, with optional inspections/plans/tests. Optional recovery and actual repairs follow. **Absent from §7.1:** upstream/local merge ownership negotiation; no real git merge runs. |
| `lockfile_churn` | PRODUCTIVE, OSCILLATING | Repairs precede 10–16 alternating dependency pins. Optional external recovery and renewed repair follow. **Absent from §7.1:** installer/resolver negotiation. Pins do not repair predicates; no package manager runs. |
| `telemetry_gaps` | PRODUCTIVE and at least one other scored class | Sample two workflows from validation stalls, serializer/merge/lock oscillation, lease retries and watermark polls, surrounded by real repairs. A transport-loss burst follows the clean workflows. Reimagines under-instrumentation (§7.1.12) across several behaviours. |

## Structural variety and transitions

Each repair chooses a still-broken predicate and independently chooses between
inspection before writing, planning before writing, inspection after validation,
or recording results after validation. Investigation optionally interleaves
tests or plans. Recovery varies episode counts, protocols, readiness delays
and side work between resolved episodes. Oscillation varies lengths and the
operations between reversals. Optional phases and handoffs vary phase counts
and boundaries. Randomness changes the number and order of operations, beyond
vocabulary or token costs.

Sessions include productive work before stalls, recovery followed by renewed
productive work, and oscillation followed by mutations that actually increase
progress. Phase boundaries are allowed to yield INSUFFICIENT_AMBIGUOUS. They
are not forced to yield a fixed label schedule: some recovery-to-stall
boundaries move directly between scored labels.

The repository has 12–18 contracts, four language/suite vocabularies, varying
error classes and generated resource identities. Generation uses only the
passed RNG, with no I/O or wall-clock reads. Across seeds 0–49, observed
lengths are 28–65 events, within the commissioned 20–90 range.

Costs are zero with probability 0.13; otherwise they are lognormal with
parameters `(7.5, 1.65)`, capped at 400,000 tokens and randomly divided between
input/output. Costs are independent of labels. High spend is not a stall rule.

## Benign lookalikes and counterfactuals

Two family pairs deliberately share their first 17 operation/category/outcome
events: `shard_migration` versus `annotation_spiral`, and `shard_migration`
versus `serializer_duel`. At endpoint 16, their identical eight-event
category/outcome windows are PRODUCTIVE versus STALLED and PRODUCTIVE versus
OSCILLATING, respectively. The causal difference is repairing distinct faults,
adding inert comments, or restoring competing contents. Variable continuations
follow these probes, so the paired prefixes do not determine session labels.

`synth_ood.counterfactuals.counterfactual_pairs(rng, session_id, cfg)` retains
the three §7.2 paired experiments. Nine byte-identical prefix events precede
one intervention: service persistence, or effective edits versus annotations
or reversals. Endpoints contrast PRODUCTIVE with STALLED or OSCILLATING.
Both alternatives share prefix IDs: keep a pair together in dataset partitions
and treat branches as alternative sessions, never concatenated histories.
Continuation costs still consume the passed RNG. These pairs remain separate
from the ten registered families.

## Telemetry loss and restoration

Telemetry samples two workflows without replacement from six mechanisms
shared with other families. Clean windows collectively cover all four scored
classes over seeds 0–49; each session has at least two scored classes.

The loss burst omits input tokens, both workspace digests, a failure
fingerprint, then suite id, passed count and total count on separate validations.
The next validation has complete current fields but an unobserved baseline.
The engine derives this dependency from previous validation observations and
sets that step's `dropped=True` too. A complete result restores the following
result's baseline. Rejected full windows are exactly those containing an
affected step, including dependent baseline loss. Rejection ends eight events
after the final affected event. Later repairs provide clean post-gap windows.

All representable §5.2 missing-observation reasons are exercised:
MISSING_TOKENS, MISSING_WORKSPACE_DIGEST, MISSING_FAILURE_FINGERPRINT,
MISSING_VALIDATION_FIELDS and UNOBSERVED_VALIDATION_BASELINE. Short prefixes
exercise TOO_SHORT. Category and outcome remain present because the shared
CanonicalEvent schema requires them; missing category/outcome cannot be emitted
while satisfying the commission's schema-validation rule. Telemetry loss
changes observations and dropped flags, never true contents or causal effects.

## Verification

Run from this directory:

```sh
PYTHONPATH=src .venv/bin/python -m pytest tests_ood -q
```

The original contract audit covers ten families over 24 seeds: byte-identical
event/record serialization, schema round trips, sequence and latent validation,
label recomputation, effect/dropped-index consistency, intended labels and each
window's gate/encoder path. Its gap test now requires all five observation-loss
reasons and restoration after the last overlapping loss. Causal engine and
counterfactual checks remain.

`tests_ood/test_revision.py` reuses a 500-session corpus for seeds 0–49. It
requires at least 40 distinct operation-family/outcome sequences per family,
varied operation order after collapsing repeated runs, at least two scored
labels per session, ordered transitions and actual progress after problematic
phases, ambiguous boundary windows, both lookalike pairs, telemetry class and
reason coverage, and exact agreement between gate rejection and dropped steps.
Focused baseline-loss tests verify restoration and unchanged causal state.

The revision audit measured **50 distinct sequences per family** and **two or
more scored labels in all 500 sessions**. Telemetry's clean windows cover
PRODUCTIVE, RECOVERY, STALLED and OSCILLATING. The tests assert these acceptance
properties rather than selecting seeds or tuning against encoded features.
# Latent effect rules (shared by every generator)

Excerpt of the harness's M1 contract, section 1. Binding for the OOD generator.

## Causal rules

The engine decides each operation's effect from **latent state**, never from encoded features or fingerprints. It applies these rules in this order:

1. **Episodes.**
   - A failure *episode* opens at the first **exact retry**: the same operation on the same relevant state, immediately after it failed or returned not-ready. It does not open on the initial failure. That keeps an ordinary failing test in an edit-then-test cycle from turning a window into RECOVERY.
   - The initial failing operation has effect `NONE`.
   - Kind `retry` (ERROR outcomes): attempts 1..`R_max` are `IN_POLICY_RETRY`, and later attempts are `REDUNDANT`.
   - Kind `poll` (NEUTRAL not-ready outcomes): attempts 1..`P_max` are `IN_POLICY_POLL`, and later attempts are `REDUNDANT`.
   - The operation that succeeds ends the episode: effect `RESOLVES_EPISODE`, `resolved_episode_here = True`.
   - An episode is abandoned when the agent does something else and never retries. It is then closed silently (`open_episode_kind = None`) at the first non-retry operation that changes relevant state, or after 2 unrelated operations.
   - At most one episode is open at a time.
   - Re-running validation on an unchanged workspace after a deterministic failure is still a retry, so attempts within `R_max` are in policy. Retries beyond `R_max` are `REDUNDANT`.
2. **Progress.** An operation that raises latent progress (`progress_after > previous`) is `PROGRESS`. Progress is credited to the mutation that fixes a fault, not to the test run that reveals the fix.
3. **Facts.** An operation that adds facts to `K` (clues about a fault, revealed by inspecting the right location, a diagnostic, or a test run that newly reveals a failure location) is `NEW_FACT`, with `new_facts` = the number added.
4. **Redundancy (§6.1 with the r2 reading in §0.2).** `REDUNDANT` covers:
   - re-reading content whose facts are all already in `K`, or re-reading content already read that yielded no facts;
   - an edit whose **behavioural** change is already present: it changes text but not behaviour, such as reformatting, renaming locals or re-adding an existing guard;
   - validation re-run when the **behavioural** workspace is unchanged since the last run of the same suite and selection, unless it is an in-policy retry under rule 1;
   - out-of-policy retries and polls;
   - re-issuing an identical plan or control step with no new information.
5. **Reversion.** An agent mutation whose latent after-state equals a latent workspace state that existed earlier in the session, and that undoes an earlier agent mutation, sets `undoes_prior_mutation = True`. Its effect is `REVERSION` if the matching state lies within its own trailing 8-event window. The labeller recomputes reversions per window.
6. Everything else is `NONE`: a novel but fruitless inspection, a novel behaviour-changing edit that doesn't help, or a first plan.

If an operation qualifies for several effects, precedence is RESOLVES_EPISODE > PROGRESS > NEW_FACT > REVERSION > IN_POLICY_RETRY/POLL > REDUNDANT > NONE. `new_facts` and `progress_after` are always recorded as they are, whatever the precedence.

`ws_before` / `ws_after` are latent workspace content ids: sha256 of the true file contents, which are unaffected by dropped observations. `CanonicalEvent.workspace_state_*` uses `fingerprint.workspace_digest` over the same contents, so the two agree whenever the observation isn't dropped.

