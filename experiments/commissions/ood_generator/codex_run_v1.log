index 0000000000000000000000000000000000000000..35d5b1100810d8d349631203918e7225c9bc237b
--- /dev/null
+++ b/src/agent_loop_lab/synth_ood/engine.py
@@ -0,0 +1,239 @@
+"""Independent, small repository interpreter and causal operation engine.
+
+Files are simulated text, never files in the caller's checkout. The interpreted
+contract is deliberately language independent: enabled=1 repairs a contract;
+mode selects a competing deployment convention without repairing a contract.
+"""
+
+from __future__ import annotations
+
+import random
+from datetime import datetime, timedelta, timezone
+
+from ..fingerprint import (
+    FAMILY_CATEGORY, failure_fingerprint, intent_fingerprint, workspace_digest,
+)
+from ..oracle_config import OracleConfig
+from ..schema import CanonicalEvent, LatentEffect as E, OracleRecord, Outcome, Provenance
+from ..synth.labeller import label_session
+from ..synth.latent import LatentStep, latent_trace
+
+
+class Repository:
+    """Textual contracts, independent facts, behaviour, and test interpretation."""
+
+    def __init__(self, rng: random.Random):
+        language, suffix, suite = rng.choice([
+            ("Elixir", "exs", "exunit:replication"),
+            ("Zig", "zig", "zig:allocator"),
+            ("Lua", "lua", "busted:stream"),
+            ("Clojure", "clj", "kaocha:ledger"),
+        ])
+        self.suite = suite
+        self.error_class = rng.choice(["ReplicaDivergence", "AllocatorInvariant", "StreamOrderViolation"])
+        self.paths = [f"lib/shards/contract_{i}.{suffix}" for i in range(rng.randint(12, 18))]
+        self.files = {p: f"# {language} contract {i}\nenabled=0\nmode=left\n"
+                      for i, p in enumerate(self.paths)}
+        self.files["config/replica.lock"] = "package=cedar\nversion=1\n"
+        self.files["config/merge.conf"] = "owner=local\n"
+
+    def behaviour(self) -> tuple:
+        return tuple((p, tuple(line for line in text.splitlines()
+                              if line and not line.startswith("#")))
+                     for p, text in sorted(self.files.items()))
+
+    def passing(self) -> int:
+        return sum("enabled=1" in self.files[p].splitlines() for p in self.paths)
+
+    def progress(self) -> float:
+        return self.passing() / len(self.paths)
+
+    def digest(self) -> str:
+        return workspace_digest(self.files)
+
+
+class Engine:
+    """Apply operations, derive effects from state, then emit observations.
+
+The only scenario input is the operation to attempt. Effects and labels are
+never supplied by scenario scripts. No encoder is imported here.
+"""
+
+    def __init__(self, rng: random.Random, session_id: str, cfg: OracleConfig):
+        self.rng, self.session_id, self.cfg = rng, session_id, cfg
+        # The API receives an RNG rather than its seed. Record a reproducible
+        # stream nonce, not a claim to know the caller's original seed.
+        self.seed = rng.getrandbits(63)
+        self.repo = Repository(rng)
+        self.p0 = self.repo.progress()
+        self.knowledge: set[str] = set()
+        self.inspected: set[tuple] = set()
+        self.validated: set[tuple] = set()
+        self.controls: set[tuple] = set()
+        self.services: dict[str, tuple[str, int]] = {}
+        self.service_calls: dict[str, int] = {}
+        self.events: list[CanonicalEvent] = []
+        self.steps: list[LatentStep] = []
+        self.states = [self.repo.digest()]
+        self.last_failure: tuple | None = None
+        self.episode_key: tuple | None = None
+        self.episode_kind: str | None = None
+        self.attempts = 0
+        self.unrelated = 0
+        self.clock = datetime(2026, 3, 14, tzinfo=timezone.utc)
+
+    def service(self, name: str, kind: str, failures: int) -> None:
+        self.services[name] = (kind, failures)
+        self.service_calls[name] = 0
+
+    def close_episode(self) -> None:
+        self.episode_key = self.episode_kind = None
+        self.attempts = self.unrelated = 0
+
+    def perform(self, family: str, target=None, args=None, *, content=None,
+                dropped: str | None = None) -> None:
+        args = dict(args or {})
+        before, behaviour, previous_p = self.repo.digest(), self.repo.behaviour(), self.repo.progress()
+        facts: set[str] = set()
+        redundant = False
+        outcome, error_class, produced = Outcome.SUCCESS, None, False
+        error_location = None
+        passed = total = suite = None
+        kind = None
+        # Relevant state for retry equality is behavioural, so cosmetic edits
+        # do not make a deterministic failing validation a fresh attempt.
+        key = (family, repr(target), repr(sorted(args.items())), behaviour)
+        if family == "read_file":
+            text = self.repo.files[target]
+            read_key = (target, text)
+            redundant = read_key in self.inspected
+            self.inspected.add(read_key)
+            if target in self.repo.paths:
+                facts = {f"{target}:predicate", f"{target}:fixture"} - self.knowledge
+                redundant = not facts
+        elif family == "write_file":
+            args = {"content": content}
+            self.repo.files[target] = content
+            redundant = self.repo.behaviour() == behaviour
+        elif family == "run_tests":
+            produced, suite = True, target
+            passed, total = self.repo.passing(), len(self.repo.paths)
+            validation_key = (target, tuple(sorted(args.get("tests", []))), behaviour)
+            key = (family, validation_key)
+            redundant = validation_key in self.validated
+            self.validated.add(validation_key)
+            if passed < total:
+                outcome, error_class, kind = Outcome.ERROR, self.repo.error_class, "retry"
+                error_location = next(p for p in self.repo.paths if "enabled=1" not in self.repo.files[p].splitlines())
+        elif family in ("http_call", "poll_status"):
+            resource = target if family == "poll_status" else target["host"]
+            error_location = resource
+            kind, failures = self.services[resource]
+            self.service_calls[resource] += 1
+            # Caller metadata such as backoff never distinguishes an attempt.
+            key = ((family, resource) if family == "poll_status" else
+                   (family, tuple(sorted(target.items())), args.get("body")))
+            if self.service_calls[resource] <= failures:
+                outcome = Outcome.NEUTRAL if kind == "poll" else Outcome.ERROR
+                error_class = "LeaseNotReady" if kind == "poll" else "PeerReset"
+            else:
+                facts = {f"service:{resource}:lease"} - self.knowledge
+        elif family == "plan":
+            control_key = (family, args["action_type"])
+            redundant = control_key in self.controls
+            self.controls.add(control_key)
+        else:
+            raise ValueError(f"unsupported simulated operation: {family}")
+
+        after = self.repo.digest()
+        mutation = before != after
+        p = self.repo.progress()
+        new_facts = len(facts)
+        self.knowledge.update(facts)
+        undo = mutation and after in self.states and len(self.states) > 1
+        recent_states = {s.ws_before for s in self.steps[-7:]} | {s.ws_after for s in self.steps[-7:]}
+        recent_states.add(before)
+        reversion = undo and after in recent_states
+
+        failed = kind is not None and outcome in (Outcome.ERROR, Outcome.NEUTRAL)
+        exact_retry = key == self.last_failure
+        resolved = False
+        policy_effect = None
+        if exact_retry:
+            if self.episode_key != key:
+                self.close_episode()
+                self.episode_key, self.episode_kind = key, kind
+            self.attempts += 1
+            self.unrelated = 0
+            if not failed:
+                resolved = True
+                self.close_episode()
+            else:
+                limit = self.cfg.p_max if kind == "poll" else self.cfg.r_max
+                policy_effect = (E.IN_POLICY_POLL if kind == "poll" else E.IN_POLICY_RETRY) if self.attempts <= limit else E.REDUNDANT
+        else:
+            if self.episode_kind:
+                self.unrelated += 1
+                if self.repo.behaviour() != behaviour or self.unrelated >= 2:
+                    self.close_episode()
+        self.last_failure = key if failed else None
+
+        if resolved:
+            effect = E.RESOLVES_EPISODE
+        elif p > previous_p:
+            effect = E.PROGRESS
+        elif new_facts:
+            effect = E.NEW_FACT
+        elif reversion:
+            effect = E.REVERSION
+        elif policy_effect is not None:
+            effect = policy_effect
+        elif redundant:
+            effect = E.REDUNDANT
+        else:
+            effect = E.NONE
+
+        i = len(self.events)
+        self.steps.append(LatentStep(
+            i, effect, p, new_facts, before, after, mutation, undo,
+            self.episode_kind, self.attempts, resolved, dropped is not None,
+        ))
+        # A zero-inflated, heavy-tailed cost law, independent of labels.
+        cost = 0 if self.rng.random() < .13 else min(400000, int(self.rng.lognormvariate(7.5, 1.65)))
+        fraction = self.rng.uniform(.35, .96)
+        input_tokens = int(cost * fraction)
+        self.clock += timedelta(milliseconds=self.rng.randint(30, 1700))
+        self.events.append(CanonicalEvent(
+            session_id=self.session_id, agent_id="worker", task_id="contract-maintenance",
+            event_id=f"{self.session_id}:{i}", sequence_index=i,
+            timestamp=self.clock.isoformat(), operation_family=family,
+            operation_category=FAMILY_CATEGORY[family], outcome=outcome,
+            intent_fingerprint=intent_fingerprint(family, target, args),
+            failure_fingerprint=(None if dropped == "failure" else failure_fingerprint(family, error_class, error_location)) if outcome is Outcome.ERROR else None,
+            workspace_state_before=None if dropped == "workspace" else before,
+            workspace_state_after=None if dropped == "workspace" else after,
+            validation_produced=produced, validation_suite_id=suite,
+            validation_passed=passed, validation_total=total,
+            input_tokens=None if dropped == "tokens" else input_tokens,
+            output_tokens=cost-input_tokens,
+            provenance=Provenance(source="simulator:ood-0.1"),
+        ))
+        self.states.append(after)
+
+    def read(self, path: str) -> None:
+        self.perform("read_file", path)
+
+    def write(self, path: str, text: str) -> None:
+        self.perform("write_file", path, content=text)
+
+    def test(self, *, dropped=None) -> None:
+        self.perform("run_tests", self.repo.suite, {"tests": ["replica-contract"]}, dropped=dropped)
+
+    def finish(self, name: str) -> tuple[list[CanonicalEvent], OracleRecord]:
+        return self.events, OracleRecord(
+            session_id=self.session_id, generator_version="ood-0.1", seed=self.seed,
+            scenario_family=f"ood:{name}", event_effects=tuple(s.effect for s in self.steps),
+            window_labels=label_session(self.steps, self.p0, self.cfg),
+            dropped_observations=tuple(s.sequence_index for s in self.steps if s.dropped),
+            latent_trace=latent_trace(self.steps, self.p0),
+        )
diff --git a/tests_ood/test_contract.py b/tests_ood/test_contract.py
new file mode 100644
index 0000000000000000000000000000000000000000..622d8a4f4d6b600d85c7049fce15cbe032fa7ea4
--- /dev/null
+++ b/tests_ood/test_contract.py
@@ -0,0 +1,191 @@
+"""Acceptance coverage across independent seeds, plus causal engine checks."""
+
+import json
+import random
+
+import numpy as np
+import pytest
+
+from agent_loop_lab.encode import encode_window
+from agent_loop_lab.fingerprint import FAMILY_CATEGORY, workspace_digest
+from agent_loop_lab.oracle_config import load_oracle_config
+from agent_loop_lab.schema import CanonicalEvent, LatentEffect as E, OracleLabel as L, OracleRecord
+from agent_loop_lab.synth.labeller import label_session, validate_steps
+from agent_loop_lab.synth.latent import steps_from_record
+from agent_loop_lab.synth_ood import FAMILIES
+from agent_loop_lab.synth_ood.engine import Engine
+from agent_loop_lab.windows import GateReason, gate, iter_windows, validate_sequence
+
+
+CFG = load_oracle_config("oracle_config.v0_2.yaml")
+INTENDED = {
+    "shard_migration": {L.PRODUCTIVE},
+    "fixture_archaeology": {L.PRODUCTIVE},
+    "lease_reconnect": {L.PRODUCTIVE, L.RECOVERY},
+    "index_watermark": {L.PRODUCTIVE, L.RECOVERY},
+    "pinned_validation": {L.RECOVERY, L.STALLED},
+    "annotation_spiral": {L.STALLED},
+    "serializer_duel": {L.OSCILLATING},
+    "merge_ping_pong": {L.OSCILLATING},
+    "lockfile_churn": {L.OSCILLATING},
+    "telemetry_gaps": {L.PRODUCTIVE},
+}
+
+
+@pytest.mark.parametrize("name", FAMILIES)
+@pytest.mark.parametrize("seed", range(24))
+def test_session_contract(name, seed):
+    generate = FAMILIES[name]
+    events, oracle = generate(random.Random(seed), "session-17", CFG)
+    other_events, other_oracle = generate(random.Random(seed), "session-17", CFG)
+    assert [e.to_json() for e in events] == [e.to_json() for e in other_events]
+    assert json.dumps(oracle.to_dict(), sort_keys=True) == json.dumps(other_oracle.to_dict(), sort_keys=True)
+    assert OracleRecord.from_dict(oracle.to_dict()) == oracle
+    assert 20 <= len(events) <= 90
+    assert oracle.generator_version == "ood-0.1"
+    assert oracle.scenario_family == f"ood:{name}"
+    steps, p0 = steps_from_record(oracle)
+    validate_steps(steps, CFG)
+    validate_sequence(events)
+    assert len(steps) == len(events)
+    assert label_session(steps, p0, CFG) == oracle.window_labels
+    assert tuple(s.effect for s in steps) == oracle.event_effects
+    assert tuple(s.sequence_index for s in steps if s.dropped) == oracle.dropped_observations
+    assert INTENDED[name] <= set(oracle.window_labels.values())
+    assert all(label.value in generate.__doc__ for label in INTENDED[name])
+    for event, step in zip(events, steps):
+        assert CanonicalEvent.from_json(event.to_json()) == event
+        assert event.operation_category == FAMILY_CATEGORY[event.operation_family]
+        assert event.sequence_index == step.sequence_index
+        assert event.session_id == oracle.session_id
+        if not step.dropped:
+            assert event.workspace_state_before == step.ws_before
+            assert event.workspace_state_after == step.ws_after
+        if step.agent_mutation:
+            assert step.ws_before != step.ws_after
+        assert event.provenance.source == "simulator:ood-0.1"
+        assert not event.provenance.instrumentation_flags
+        assert name not in event.to_json()
+    for result in iter_windows(events):
+        t = result.endpoint_index
+        dropped = any(s.dropped for s in steps[t-7:t+1])
+        assert result.gate.passed == (not dropped)
+        assert (oracle.window_labels[t] == L.INSUFFICIENT_INSTRUMENTATION) == dropped
+        if result.gate.passed:
+            assert result.features.shape == (120,)
+            assert result.features.dtype == np.float32
+            assert np.isfinite(result.features).all()
+        else:
+            assert name == "telemetry_gaps"
+            assert result.features is None
+
+
+@pytest.mark.parametrize("name", FAMILIES)
+def test_rng_controls_variation(name):
+    sessions = [FAMILIES[name](random.Random(i), "s", CFG)[0] for i in range(8)]
+    assert len({len(events) for events in sessions}) > 1 or name == "telemetry_gaps"
+    assert len({events[0].to_json() for events in sessions}) > 1
+
+
+def engine(seed=1):
+    return Engine(random.Random(seed), "causal", CFG)
+
+
+def test_real_text_drives_progress_validation_and_digest():
+    e = engine()
+    path = e.repo.paths[0]
+    e.test()
+    old = e.repo.digest()
+    e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
+    e.test()
+    assert e.events[0].validation_passed == 0
+    assert e.events[-1].validation_passed == 1
+    assert e.steps[1].effect == E.PROGRESS
+    assert e.steps[2].effect == E.NONE
+    assert e.steps[1].progress_after == 1 / len(e.repo.paths)
+    assert old != e.repo.digest() == workspace_digest(e.repo.files)
+    assert e.events[-1].workspace_state_after == e.repo.digest()
+
+
+def test_facts_and_cosmetic_writes_are_not_progress():
+    e = engine()
+    path = e.repo.paths[0]
+    e.read(path)
+    e.read(path)
+    e.write(path, e.repo.files[path] + "# formatting only\n")
+    assert [s.effect for s in e.steps] == [E.NEW_FACT, E.REDUNDANT, E.REDUNDANT]
+    assert [s.new_facts for s in e.steps] == [2, 0, 0]
+    assert all(s.progress_after == 0 for s in e.steps)
+    assert e.steps[-1].agent_mutation
+
+
+def test_retry_budget_and_episode_resolution():
+    e = engine()
+    e.service("peer.cedar.invalid", "retry", 5)
+    target = {"method": "GET", "host": "peer.cedar.invalid", "path_template": "/lease"}
+    for _ in range(6):
+        e.perform("http_call", target)
+    assert [s.effect for s in e.steps] == [E.NONE] + [E.IN_POLICY_RETRY]*3 + [E.REDUNDANT, E.RESOLVES_EPISODE]
+    assert e.steps[0].open_episode_kind is None
+    assert e.steps[1].open_episode_attempts == 1
+    assert e.steps[-1].open_episode_kind is None
+    assert e.steps[-1].resolved_episode_here
+    # New service knowledge is recorded even though resolution has precedence.
+    assert e.steps[-1].new_facts == 1
+
+
+def test_poll_budget_ignores_backoff_metadata():
+    e = engine()
+    e.service("index:42", "poll", 7)
+    for i in range(8):
+        e.perform("poll_status", "index:42", {"backoff": 2**i})
+    assert [s.effect for s in e.steps] == [E.NONE] + [E.IN_POLICY_POLL]*5 + [E.REDUNDANT, E.RESOLVES_EPISODE]
+    assert len({ev.intent_fingerprint for ev in e.events}) == 1
+
+
+def test_episode_abandonment_and_cosmetic_validation():
+    e = engine()
+    e.test()
+    e.test()
+    assert e.steps[-1].open_episode_kind == "retry"
+    path = e.repo.paths[0]
+    e.write(path, e.repo.files[path].replace("enabled=0", "enabled=1"))
+    assert e.steps[-1].open_episode_kind is None
+    assert e.steps[-1].effect == E.PROGRESS
+    e.test()
+    e.test()
+    e.perform("plan", args={"action_type": "consider"})
+    assert e.steps[-1].open_episode_kind == "retry"
+    e.perform("plan", args={"action_type": "consider-more"})
+    assert e.steps[-1].open_episode_kind is None
+    e.write(path, e.repo.files[path] + "# pretty\n")
+    e.test()
+    assert e.steps[-1].effect == E.REDUNDANT
+
+
+def test_reversion_and_restored_progress_are_derived():
+    e = engine()
+    path = e.repo.paths[0]
+    original = e.repo.files[path]
+    e.write(path, original.replace("enabled=0", "enabled=1"))
+    e.write(path, original)
+    e.write(path, original.replace("enabled=0", "enabled=1"))
+    assert [s.effect for s in e.steps] == [E.PROGRESS, E.REVERSION, E.PROGRESS]
+    assert e.steps[-1].undoes_prior_mutation  # progress outranks reversion
+    validate_steps(e.steps, CFG)
+
+
+def test_dropped_reason_coverage_and_recovery_after_gap():
+    events, oracle = FAMILIES["telemetry_gaps"](random.Random(9), "s", CFG)
+    reasons = {reason for t in range(7, len(events)) for _, reason in gate(events[:t+1]).reasons}
+    assert reasons == {GateReason.MISSING_TOKENS, GateReason.MISSING_WORKSPACE_DIGEST, GateReason.MISSING_FAILURE_FINGERPRINT}
+    for i in oracle.dropped_observations:
+        assert not gate(events[:i+1]).passed
+        assert gate(events[:i+9]).passed
+
+
+def test_encoding_is_prefix_causal():
+    events, _ = FAMILIES["shard_migration"](random.Random(2), "s", CFG)
+    first = encode_window(events[:8]).tobytes()
+    list(iter_windows(events))
+    assert encode_window(events[:8]).tobytes() == first

