# REVISION.edits: Phase B revision applied on top of r1's weights (see REVISION.md and CIRCUITS.md)
# Statements apply in order. Blank lines and # comments are ignored.

# ================ A. token embedding: flags ================
# A1. d9 was 'in' (used only by r1's FNC unit, dropped) -> the ':' flag
tok_emb.weight[36, 9] = 0
tok_emb.weight[143, 9] = 1
# A2. d10 was 'lines' (used only by r1's has_lines head, dropped) -> the ok/ready status flag
tok_emb.weight[22, 10] = 0
tok_emb.weight[38, 10] = 1
tok_emb.weight[42, 10] = 1
# A3. d11 = build/lint tool flag
tok_emb.weight[14:16, 11] = 1
# A4. d12 was 'any tool name' (used only by the layer-0 broadcast key, now keyed on offset 7) -> run_tests flag
tok_emb.weight[7:21, 12] = 0
tok_emb.weight[13, 12] = 1
# A5. d13 = poll_status flag; d16 = http_call flag
tok_emb.weight[17, 13] = 1
tok_emb.weight[16, 16] = 1
# A6. d18 was the status-word flag (the status broadcast now keys on d14 d15 d17 d10 directly) -> plan/ask/yield flag
tok_emb.weight[38:41, 18] = 0
tok_emb.weight[42:44, 18] = 0
tok_emb.weight[18:21, 18] = 1
# A7. the punctuation token '.' (id 141: the path '.' and the first token of dot-files) gets the hashed flag and
#     codes A and B (141 mod 4,5,7 = 1,1,1; 141 mod 3,13 = 0,11) so it can be a target key
tok_emb.weight[141, 1] = 1
tok_emb.weight[141, 33] = 1
tok_emb.weight[141, 37] = 1
tok_emb.weight[141, 42] = 1
tok_emb.weight[141, 48] = 1
tok_emb.weight[141, 62] = 1

# ================ B. layer 0 attention ================
# B1. heads 0 and 1 (previous token / token two back): double the query so the copies are exact (scores -16*(d-k)^2)
layers.0.attn.q.weight[0:3, :] *= 2
layers.0.attn.q.weight[16:19, :] *= 2
# B2. head 0: drop the 'prev1 is FAILED' copy (d26 is re-assigned), add 'prev1 is :' -> d24
layers.0.attn.v.weight[1, 15] = 0
layers.0.attn.o.weight[26, 1] = 0
layers.0.attn.v.weight[2, 9] = 1
layers.0.attn.o.weight[24, 2] = 1
# B3. head 1: add 'prev2 is >' -> d26
layers.0.attn.v.weight[17, 3] = 1
layers.0.attn.o.weight[26, 17] = 1
# B4. head 2 (tool-class broadcast): key on offset 7 alone; broadcast eight class flags in place (d6 d7 d8 d11 d12 d13 d16 d18)
layers.0.attn.k.weight[32, 12] = 0
layers.0.attn.k.bias[32] = 0
layers.0.attn.o.weight[28, 32] = 0
layers.0.attn.o.weight[29, 33] = 0
layers.0.attn.o.weight[30, 34] = 0
