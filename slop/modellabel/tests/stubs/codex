#!/usr/bin/env python3
"""Stub `codex exec --json -o FILE --output-schema FILE -` for the modellabel tests (see stubcore.py)."""

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import stubcore as sc  # noqa: E402

argv = sys.argv[1:]
if argv == ["--version"]:
    print("codex-cli 0.160.1 [stub]")
    sys.exit(0)
if not argv or argv[0] != "exec":
    print("stub codex: only exec is supported", file=sys.stderr)
    sys.exit(2)
schema = sc.arg_value(argv, "--output-schema")
out = sc.arg_value(argv, "-o", "--output-last-message")
if not schema or not os.path.exists(schema):
    print("error: --output-schema file missing", file=sys.stderr)
    sys.exit(1)
json.load(open(schema))
text = sc.read_stdin()
sc.log_call("codex", argv, text)
action = sc.next_action("codex")
sc.maybe_sleep()


def emit(ev):
    print(json.dumps(ev), flush=True)


emit({"type": "thread.started", "thread_id": "stub-thread"})
emit({"type": "turn.started"})
if action == "error":
    emit({"type": "error", "message": "stream disconnected before completion"})
    emit({"type": "turn.failed", "error": {"message": "stream disconnected before completion"}})
    sys.exit(1)
if action == "tools":
    emit({"type": "item.started", "item": {"id": "item_0", "type": "command_execution", "command": "ls"}})
    emit({"type": "item.completed", "item": {"id": "item_0", "type": "command_execution", "command": "ls",
                                             "aggregated_output": "", "exit_code": 0, "status": "completed"}})
if action == "unknown_item":
    emit({"type": "item.started", "item": {"id": "item_9", "type": "file_read", "path": "/etc/hosts"}})
msg = sc.answer("codex", text, action)
emit({"type": "item.completed", "item": {"id": "item_1", "type": "agent_message", "text": msg}})
emit({"type": "turn.completed", "usage": {"input_tokens": len(text) // 3, "cached_input_tokens": 6000,
                                          "output_tokens": 800, "reasoning_output_tokens": 500}})
if out:
    with open(out, "w") as f:
        f.write(msg)
