layers.0.attn.o.weight[16, 38] = 1
layers.0.attn.v.weight[39, 18] = 1
layers.0.attn.o.weight[18, 39] = 1
# B5. head 4 (new): status broadcast within the event, keyed on the status-word flags: error->d114 pending->d115 FAILED->d28 ok/ready->d29
layers.0.attn.q.bias[64] = 1
layers.0.attn.k.weight[64, 14] = 80
layers.0.attn.k.weight[64, 15] = 80
layers.0.attn.k.weight[64, 17] = 80
layers.0.attn.k.weight[64, 10] = 80
